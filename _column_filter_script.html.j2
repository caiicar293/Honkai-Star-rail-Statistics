<script>
// ── Column value filter (DuckDB VS Code extension style) ───────────────────
// Click the small funnel icon in any filterable <th data-col="..."> to open
// a filter popover for that column with three cooperating controls:
//   1. Checkbox list  — uncheck values to EXCLUDE them (classic behavior)
//   2. OR FILTER BY   — one value rule: Equals / Not equals / Contains / ...
//   3. RANGE          — numeric Min–Max bounds
// All active rules for a column are ANDed together, and combined with every
// other active filter (dim/eidolon/search/etc.) via ColumnFilter.passes(row).
// Each page wires that into its own recompute() filter chain, and calls
// ColumnFilter.attach('#mainTable', () => RAW_DATA, recompute) once.
const ColumnFilter = (() => {
  let getData   = () => [];
  let onChange  = () => {};
  let table     = null;
  const state   = new Map(); // col -> { excluded: Set<label>, valueRule: {op,value}, range: {min,max} }
  let openPopover = null;
  let openCol      = null;

  const OPTS = [
    ['equals',        'Equals'],
    ['not_equals',    'Not equals'],
    ['contains',      'Contains'],
    ['not_contains',  'Not contains'],
    ['starts_with',   'Starts with'],
    ['ends_with',     'Ends with'],
    ['gt',            'Greater than'],
    ['lt',            'Less than'],
    ['is_empty',      'Is empty'],
    ['is_not_empty',  'Is not empty'],
  ];

  function fmtVal(v) {
    if (v === null || v === undefined || v === '') return '(blank)';
    if (typeof v === 'boolean') return v ? 'true' : 'false';
    if (typeof v === 'number') return Number.isInteger(v) ? String(v) : v.toFixed(2);
    return String(v);
  }

  // Raw string form used by the OR-filter value rules (no float rounding).
  function rawLabel(v) {
    if (v === null || v === undefined || v === '') return '(blank)';
    return String(v);
  }

  function valuesFor(col) {
    const counts = new Map();
    getData().forEach(r => {
      const label = fmtVal(r[col]);
      const entry = counts.get(label);
      if (entry) entry.count++; else counts.set(label, { count: 1 });
    });
    return [...counts.entries()].sort((a, b) => b[1].count - a[1].count || a[0].localeCompare(b[0]));
  }

  function valueRulePasses(v, rule) {
    if (rule.op === 'is_empty')     return v === null || v === undefined || v === '';
    if (rule.op === 'is_not_empty') return v !== null && v !== undefined && v !== '';
    const label  = rawLabel(v).toLowerCase();
    const needle = String(rule.value).toLowerCase();
    switch (rule.op) {
      case 'equals':       return label === needle;
      case 'not_equals':   return label !== needle;
      case 'contains':     return label.includes(needle);
      case 'not_contains': return !label.includes(needle);
      case 'starts_with':  return label.startsWith(needle);
      case 'ends_with':    return label.endsWith(needle);
      case 'gt': { const n = Number(v); return !isNaN(n) && n > Number(rule.value); }
      case 'lt': { const n = Number(v); return !isNaN(n) && n < Number(rule.value); }
    }
    return true;
  }

  function rangePasses(v, range) {
    if (v === null || v === undefined || v === '') return false;
    const n = Number(v);
    if (isNaN(n)) return false;
    if (range.min !== null && n < range.min) return false;
    if (range.max !== null && n > range.max) return false;
    return true;
  }

  function passes(row) {
    for (const [col, f] of state.entries()) {
      if (!f) continue;
      const v = row[col];
      if (f.excluded && f.excluded.size > 0 && f.excluded.has(fmtVal(v))) return false;
      if (f.valueRule && !valueRulePasses(v, f.valueRule)) return false;
      if (f.range && !rangePasses(v, f.range)) return false;
    }
    return true;
  }

  function isActive(col) {
    const f = state.get(col);
    return !!(f && ((f.excluded && f.excluded.size > 0) || f.valueRule || f.range));
  }

  function labelForCol(col) {
    const th = table && table.querySelector(`th[data-col="${col}"]`);
    if (!th) return col;
    return th.textContent.replace(/[⚲▾↓↑]/g, '').trim();
  }

  function syncButtonState(col) {
    const btn = table.querySelector(`.col-filter-btn[data-filter-col="${col}"]`);
    if (btn) btn.classList.toggle('active', isActive(col));
    const th = btn && btn.closest('th');
    if (th) th.classList.toggle('has-filter', isActive(col));
  }

  function ruleDesc(f) {
    const parts = [];
    if (f.excluded && f.excluded.size > 0) parts.push(`${f.excluded.size} excluded`);
    if (f.valueRule) {
      const opLabel = OPTS.find(([k]) => k === f.valueRule.op)?.[1] || f.valueRule.op;
      parts.push((f.valueRule.op === 'is_empty' || f.valueRule.op === 'is_not_empty')
        ? opLabel
        : `${opLabel} "${f.valueRule.value}"`);
    }
    if (f.range) {
      const lo = f.range.min === null ? '−∞' : f.range.min;
      const hi = f.range.max === null ? '∞' : f.range.max;
      parts.push(`[${lo}, ${hi}]`);
    }
    return parts.join(' · ');
  }

  function renderActiveBar() {
    const bar = document.getElementById('activeFiltersBar');
    if (!bar) return;
    const cols = [...state.keys()].filter(c => isActive(c));
    if (cols.length === 0) { bar.innerHTML = ''; return; }
    let html = cols.map(col => {
      const desc = ruleDesc(state.get(col));
      return `<span class="af-chip" data-col="${col}">${labelForCol(col)}<span class="af-chip-desc">${desc}</span><button data-clear-col="${col}" title="Clear this filter">×</button></span>`;
    }).join('');
    html += `<button class="af-chip-clearall" id="afClearAll">Clear all filters</button>`;
    bar.innerHTML = html;
    bar.querySelectorAll('[data-clear-col]').forEach(b => {
      b.addEventListener('click', () => {
        state.delete(b.dataset.clearCol);
        syncButtonState(b.dataset.clearCol);
        renderActiveBar();
        onChange();
      });
    });
    const clearAllBtn = document.getElementById('afClearAll');
    if (clearAllBtn) clearAllBtn.addEventListener('click', () => {
      [...state.keys()].forEach(syncButtonState);
      state.clear();
      renderActiveBar();
      onChange();
    });
  }

  function closePopover() {
    if (openPopover) { openPopover.remove(); openPopover = null; }
    if (openCol) {
      const btn = table.querySelector(`.col-filter-btn[data-filter-col="${openCol}"]`);
      if (btn) btn.classList.remove('open');
    }
    openCol = null;
    document.removeEventListener('mousedown', outsideClick, true);
  }

  function outsideClick(e) {
    if (openPopover && !openPopover.contains(e.target) && !e.target.closest('.col-filter-btn')) closePopover();
  }

  function openPopoverFor(col, btn) {
    if (openCol === col) { closePopover(); return; }
    closePopover();
    openCol = col;
    btn.classList.add('open');

    const entries  = valuesFor(col);
    const f        = state.get(col) || {};
    const excluded = f.excluded || new Set();

    const pop = document.createElement('div');
    pop.className = 'col-filter-popover';
    pop.innerHTML = `
      <div class="cf-or">
        <div class="cf-section-label">OR FILTER BY</div>
        <div class="cf-or-row">
          <select class="cf-op">
            ${OPTS.map(([k, l]) => `<option value="${k}">${l}</option>`).join('')}
          </select>
          <input type="text" class="cf-or-value" placeholder="Enter value..." />
        </div>
      </div>
      <div class="cf-range">
        <div class="cf-section-label">RANGE</div>
        <div class="cf-range-row">
          <input type="number" class="cf-range-min" placeholder="Min" step="any" />
          <span class="cf-range-sep">–</span>
          <input type="number" class="cf-range-max" placeholder="Max" step="any" />
        </div>
      </div>
      <div class="cf-search"><input type="text" placeholder="Search values…" /></div>
      <div class="cf-actions">
        <button type="button" data-act="all">Select All</button>
        <button type="button" data-act="clear">Clear</button>
      </div>
      <div class="cf-list"></div>
      <div class="cf-footer"><span></span><button type="button" data-act="apply">Apply</button></div>
    `;
    document.body.appendChild(pop);

    const rect = btn.getBoundingClientRect();
    const popW = 264;
    const left = Math.max(8, Math.min(rect.left, window.innerWidth - popW - 12));
    const top  = Math.min(rect.bottom + 4, window.innerHeight - 60);
    pop.style.left = left + 'px';
    pop.style.top  = top + 'px';
    pop.style.maxHeight = Math.min(360, window.innerHeight - top - 12) + 'px';

    const listEl       = pop.querySelector('.cf-list');
    const searchEl     = pop.querySelector('.cf-search input');
    const footerCount  = pop.querySelector('.cf-footer span');
    const opSelect     = pop.querySelector('.cf-op');
    const orValueEl    = pop.querySelector('.cf-or-value');
    const minEl        = pop.querySelector('.cf-range-min');
    const maxEl        = pop.querySelector('.cf-range-max');
    const checkedState = new Map(entries.map(([label]) => [label, !excluded.has(label)]));

    // Restore any existing rule/range for this column.
    if (f.valueRule) {
      opSelect.value = f.valueRule.op;
      orValueEl.value = f.valueRule.value;
    }
    if (f.range) {
      if (f.range.min !== null) minEl.value = f.range.min;
      if (f.range.max !== null) maxEl.value = f.range.max;
    }

    function syncOrValueVisibility() {
      const noValue = opSelect.value === 'is_empty' || opSelect.value === 'is_not_empty';
      orValueEl.style.display = noValue ? 'none' : '';
      orValueEl.placeholder = (opSelect.value === 'gt' || opSelect.value === 'lt')
        ? 'Enter number...' : 'Enter value...';
    }
    syncOrValueVisibility();
    opSelect.addEventListener('change', syncOrValueVisibility);

    function updateFooter() {
      const checkedCount = [...checkedState.values()].filter(Boolean).length;
      footerCount.textContent = `${checkedCount}/${entries.length} selected`;
    }

    function renderList(q) {
      q = (q || '').toLowerCase();
      const shown = entries.filter(([label]) => label.toLowerCase().includes(q));
      listEl.innerHTML = shown.length === 0
        ? `<div class="cf-empty">No matching values</div>`
        : shown.map(([label, info]) => `
            <label class="cf-item">
              <input type="checkbox" data-label="${label.replace(/"/g, '&quot;')}" ${checkedState.get(label) ? 'checked' : ''}/>
              <span class="cf-val">${label}</span>
              <span class="cf-count">${info.count.toLocaleString()}</span>
            </label>
          `).join('');
      updateFooter();
    }
    renderList('');

    searchEl.addEventListener('input', () => renderList(searchEl.value));
    listEl.addEventListener('change', e => {
      const cb = e.target.closest('input[type=checkbox]');
      if (!cb) return;
      checkedState.set(cb.dataset.label, cb.checked);
      updateFooter();
    });
    pop.querySelector('[data-act="all"]').addEventListener('click', () => {
      entries.forEach(([label]) => checkedState.set(label, true));
      renderList(searchEl.value);
    });
    pop.querySelector('[data-act="clear"]').addEventListener('click', () => {
      entries.forEach(([label]) => checkedState.set(label, false));
      renderList(searchEl.value);
    });

    function applyRule() {
      const newExcluded = new Set();
      checkedState.forEach((isChecked, label) => { if (!isChecked) newExcluded.add(label); });
      const op  = opSelect.value;
      const raw = orValueEl.value.trim();
      const valueRule = (op === 'is_empty' || op === 'is_not_empty')
        ? { op, value: '' }
        : (raw !== '' ? { op, value: raw } : null);
      const minRaw = minEl.value.trim();
      const maxRaw = maxEl.value.trim();
      const range = (minRaw !== '' || maxRaw !== '')
        ? { min: minRaw === '' ? null : Number(minRaw), max: maxRaw === '' ? null : Number(maxRaw) }
        : null;
      const next = {};
      if (newExcluded.size > 0) next.excluded = newExcluded;
      if (valueRule) next.valueRule = valueRule;
      if (range) next.range = range;
      if (Object.keys(next).length === 0) state.delete(col); else state.set(col, next);
      syncButtonState(col);
      renderActiveBar();
      closePopover();
      onChange();
    }
    pop.querySelector('[data-act="apply"]').addEventListener('click', applyRule);
    orValueEl.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); applyRule(); } });
    minEl.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); applyRule(); } });
    maxEl.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); applyRule(); } });

    openPopover = pop;
    setTimeout(() => document.addEventListener('mousedown', outsideClick, true), 0);
  }

  function attach(tableSelector, dataGetter, changeCallback) {
    table    = document.querySelector(tableSelector);
    getData  = dataGetter;
    onChange = changeCallback;
    if (!table) return;
    table.querySelectorAll('th[data-col]').forEach(th => {
      if (th.querySelector('.col-filter-btn')) return;
      const col = th.dataset.col;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'col-filter-btn';
      btn.dataset.filterCol = col;
      btn.title = 'Filter by value';
      btn.innerHTML = `<svg viewBox="0 0 16 16" fill="currentColor"><path d="M1 2h14l-5.5 6.5V14l-3-1.5V8.5z"/></svg>`;
      btn.addEventListener('click', e => {
        e.stopPropagation();
        openPopoverFor(col, btn);
      });
      th.appendChild(btn);
    });
  }

  // Clear all active filters — used when the underlying column set changes
  // (e.g. a tab switch to a table with a different schema) so stale filters
  // don't silently hide rows on columns that no longer mean the same thing.
  function reset() {
    closePopover();
    state.clear();
    renderActiveBar();
  }

  return { attach, passes, isActive, reset };
})();
</script>