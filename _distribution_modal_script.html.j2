<script>
// ── Distribution modal ───────────────────────────────────────────────────
// Renders per-row Scores_Distributions (STRUCT(Scores, count)[]) as a
// frequency histogram, opened via a per-row "Dist" button. Multiple rows
// can be open at once, switchable via a vertical tab rail down the left
// side of the modal — re-clicking an already-open row just re-activates
// its tab instead of stacking a duplicate. There is no cap on how many
// tabs can be open at once; a "Clear all" button in the tab rail closes
// every open tab in one click (same idea as the trends page's "Clear all").
//
// Exposes: window.openDistribution(row, label, metaHtml)
//   row      - the data row object (must carry Scores_Distributions)
//   label    - short text shown on the tab (also used to look up per-
//              character icons — see iconTokensFor/iconStripHtml below)
//   metaHtml - optional extra <div class="dist-meta-chip">...</div> markup
//              appended to the meta row (e.g. dim/eidolon context)
(function() {
  // MOC & Anomaly are cycle-based (fewer cycles = better) — bars sort
  // highest → lowest so the best (minimum) value sits on the right.
  // Apoc & Pure Fiction are point-based — bars sort lowest → highest.
  const DIST_DESCENDING = {{ 'true' if file_prefix in ['moc', 'anomaly'] else 'false' }};
  const DIST_UNIT = '{{ "Cycles" if file_prefix in ["moc", "anomaly"] else "Points" }}';
  // Point modes (Apoc/PF) arrive pre-binned into fixed-width buckets, so
  // their axis labels read as ranges ("0 - 50", "50 - 100", …) — including
  // the top bin, which reads as a range too (e.g. "3950 - 4000") by
  // inferring the bucket width from the preceding gap rather than just
  // stopping at its own value. Cycle modes keep single-value labels.
  const DIST_RANGED = DIST_UNIT === 'Points';

  const overlay      = document.getElementById('distModalOverlay');
  const tabsEl        = document.getElementById('distTabs');
  const clearAllBtn   = document.getElementById('distTabsClearAll');
  const bodyEl        = document.getElementById('distModalBody');
  const closeBtn      = document.getElementById('distModalClose');
  const tooltipEl     = document.getElementById('distTooltip');
  const reopenBtn     = document.getElementById('distReopenBtn');
  const countEl       = document.getElementById('distReopenCount');
  const rowLabelEl    = document.getElementById('distModalRowLabel');
  const rowLabelIcons = document.getElementById('distModalRowLabelIcons');
  const metaEl        = document.getElementById('distModalMeta');
  if (!overlay) return;

  // ── Character icons — same lookup convention as every other dashboard
  //    on the site (see trends_template.html.j2 / teams_template.html.j2),
  //    kept local to this IIFE so it never collides with a same-named
  //    ICONS/lookupIconUrl the host page may already declare in its own
  //    top-level script. Falls back to empty/no-op if the host page didn't
  //    wire icons_json/path_prefix into this template's context. ──
  const ICONS = {{ icons_json | default('{}') }};
  const ICON_PATH_PREFIX = "{{ path_prefix | default('../') }}";

  function lookupIconUrl(name) {
    let url = ICONS[name];
    if (!url) url = ICONS[name.replace(/\s+LV\.\d+$/, '').trim()];
    if (!url) url = ICONS[name.replace(/\s*\(E\d+\)$/i, '').trim()];
    if (!url) return null;
    if (!url.startsWith('http')) url = ICON_PATH_PREFIX + url;
    return url;
  }

  // Row labels come in a few shapes depending on which page opened the
  // modal: a plain character name, a composite "A + B" (archetype cores),
  // or a paren-wrapped team roster "(A, B, C, D)". Handle all three, same
  // as trends_template.html.j2's iconTokensFor().
  function iconTokensFor(id) {
    const s = String(id).trim();
    if (s.startsWith("(") && s.endsWith(")")) {
      return s.slice(1, -1).split(/\s*,\s*/).map(t => t.trim()).filter(Boolean);
    }
    return s.split(" + ").map(t => t.trim()).filter(Boolean);
  }

  function iconStripHtml(id) {
    const tokens = iconTokensFor(id);
    const imgs = tokens.map(t => {
      const url = lookupIconUrl(t);
      return url ? `<img src="${url}" alt="" loading="lazy" onerror="this.remove()"/>` : "";
    }).filter(Boolean);
    if (!imgs.length) return "";
    return `<span class="dist-tab-icons">${imgs.join("")}</span>`;
  }

  // tabs: [{ id, key, label, meta, bins, total }] — unlimited, no cap.
  let tabs = [];
  let activeId = null;
  let seq = 0;

  function computeBins(raw) {
    const arr = Array.isArray(raw) ? raw.slice() : [];
    // Always establish the true ascending-by-score order first — percentile
    // is defined on that axis regardless of which direction the bars are
    // ultimately displayed in.
    arr.sort((a, b) => a.Scores - b.Scores);
    const total = arr.reduce((s, b) => s + (b.count || 0), 0);
    let cum = 0;
    let bins = arr.map((b, i) => {
      const count = b.count || 0;
      const cumBefore = cum;
      cum += count;
      // Each bin spans a range of percentiles — from the cumulative total
      // just below it (cumBefore) up to the cumulative total including it
      // (cum). Report the MIDPOINT of that range rather than its upper
      // edge, so a bin covering e.g. percentile 95–97 reports 96, not 97.
      let percentile = 0;
      if (total) {
        if (DIST_DESCENDING) {
          // Descending (cycle) modes: percentile = % of samples at-or-above
          // this score, so the range runs from (total-cum)/total (excluding
          // this bin's own samples) up to (total-cumBefore)/total
          // (including them) — same midpoint logic, mirrored.
          const pctHigh = ((total - cumBefore) / total) * 100;
          const pctLow  = ((total - cum) / total) * 100;
          percentile = (pctHigh + pctLow) / 2;
        } else {
          const pctHigh = (cum / total) * 100;
          const pctLow  = (cumBefore / total) * 100;
          percentile = (pctHigh + pctLow) / 2;
        }
      }
      return {
        score: b.Scores,
        count: count,
        label: binLabel(arr, i),
        pctOfTotal: total ? (count / total) * 100 : 0,
        percentile: percentile,
      };
    });
    if (DIST_DESCENDING) bins = bins.reverse(); // display order: max → min, min on the right
    return { bins, total };
  }

  // Label for bin i of the ascending-sorted array. Point modes show the bin
  // as a range up to the next bin. The TOP bin (no "next" bin to borrow an
  // upper edge from) infers its own width from the gap to the previous bin
  // — since point-mode bins are fixed-width buckets, that gap IS the bucket
  // width — so it reads as a range too (e.g. "3950 - 4000" for an Apoc max
  // of 4000, or "39500 - 40000" for a Pure Fiction max of 40000) instead of
  // just stopping at its own value, which misleadingly read as an exact cap.
  function binLabel(sorted, i) {
    if (!DIST_RANGED) return fmtScore(sorted[i].Scores);
    const next = sorted[i + 1];
    if (next) return `${fmtScore(sorted[i].Scores)} - ${fmtScore(next.Scores)}`;
    const prev = sorted[i - 1];
    const step = prev ? (sorted[i].Scores - prev.Scores) : 0;
    return step > 0
      ? `${fmtScore(sorted[i].Scores)} - ${fmtScore(sorted[i].Scores + step)}`
      : fmtScore(sorted[i].Scores);
  }

  window.openDistribution = function(row, label, metaHtml) {
    const raw = row && row.Scores_Distributions;
    const { bins, total } = computeBins(raw || []);
    const key = (label || 'Row') + '¦' + (metaHtml || '');
    const existing = tabs.find(t => t.key === key);
    if (existing) {
      // Row already open — refresh its data and jump back to it.
      existing.bins = bins;
      existing.total = total;
      existing.meta = metaHtml || '';
      activeId = existing.id;
    } else {
      // No MAX_TABS cap — every row a person opens stays open until they
      // close its tab or hit "Clear all".
      const id = 'dt' + (++seq);
      tabs.push({ id, key, label: label || 'Row', meta: metaHtml || '', bins, total });
      activeId = id;
    }
    overlay.classList.add('open');
    syncBadge();
    render();
  };

  // Second gateway: the header "Distributions" button re-opens the modal
  // with every tab that's still open (rows already viewed are preserved — no
  // need to re-select an entry). If nothing has been opened yet, it shows a hint.
  window.reopenDistribution = function() {
    syncBadge();
    overlay.classList.add('open');
    render();
  };

  // Keep the header button's badge in sync with the number of open tabs.
  function syncBadge() {
    if (!reopenBtn) return;
    reopenBtn.classList.toggle('has-data', tabs.length > 0);
    if (countEl) {
      countEl.textContent = tabs.length;
      countEl.hidden = tabs.length === 0;
    }
  }

  function closeTab(id, e) {
    if (e) e.stopPropagation();
    tabs = tabs.filter(t => t.id !== id);
    if (activeId === id) activeId = tabs.length ? tabs[tabs.length - 1].id : null;
    syncBadge();
    render();
  }

  // "Clear all" — closes every open tab at once, mirroring the trends
  // page's "Clear all" for its comparison selection. Leaves the modal open
  // on an empty state rather than closing it outright, so re-opening a new
  // row from the table right after feels like a fresh start, not a re-open.
  function closeAllTabs(e) {
    if (e) e.stopPropagation();
    tabs = [];
    activeId = null;
    syncBadge();
    render();
  }

  function activate(id) { activeId = id; render(); }

  function closeModal() {
    overlay.classList.remove('open');
    tooltipEl.style.display = 'none';
  }

  function fmtScore(v) { return Number.isInteger(v) ? v.toLocaleString() : v.toFixed(1); }

  function render() {
    tabsEl.innerHTML = tabs.map(t => `
      <div class="dist-tab${t.id === activeId ? ' active' : ''}" data-tab="${t.id}">
        ${iconStripHtml(t.label)}
        <span class="tab-label" title="${t.label}">${t.label}</span>
        <button class="dist-tab-close" data-close="${t.id}" title="Close">×</button>
      </div>`).join('');

    if (clearAllBtn) clearAllBtn.disabled = tabs.length === 0;

    tabsEl.querySelectorAll('.dist-tab').forEach(el => {
      el.addEventListener('click', () => activate(el.dataset.tab));
    });
    tabsEl.querySelectorAll('.dist-tab-close').forEach(el => {
      el.addEventListener('click', (e) => closeTab(el.dataset.close, e));
    });

    const t = tabs.find(x => x.id === activeId);
    if (!t) {
      if (rowLabelEl) rowLabelEl.textContent = '';
      if (rowLabelIcons) rowLabelIcons.innerHTML = '';
      if (metaEl) metaEl.innerHTML = '';
      bodyEl.innerHTML = tabs.length
        ? ''
        : `<div class="dist-empty">Nothing to show yet — click the <b>Dist</b> button on any row to open its distribution, then come back here to re-view them.</div>`;
      return;
    }
    if (rowLabelEl) rowLabelEl.textContent = t.label;
    if (rowLabelIcons) rowLabelIcons.innerHTML = iconStripHtml(t.label);
    if (metaEl) metaEl.innerHTML = t.meta || '';

    if (!t.bins.length) {
      bodyEl.innerHTML = `<div class="dist-empty">No distribution data available for this row.</div>`;
      return;
    }

    const maxCount = Math.max(...t.bins.map(b => b.count));
    // The last bin in *display* order is always the best-performing end,
    // whichever direction that is (see computeBins).
    const bestIdx  = t.bins.length - 1;
    const minScore = DIST_DESCENDING ? t.bins[t.bins.length - 1].score : t.bins[0].score;
    const maxScore = DIST_DESCENDING ? t.bins[0].score : t.bins[t.bins.length - 1].score;

    // Size columns to the widest axis label so range labels ("3950 - 4000")
    // always fit — bars and labels share the same column width to stay aligned.
    const widestLabel = Math.max(...t.bins.map(b => b.label.length));
    const colW = Math.max(22, Math.ceil(widestLabel * 5.9) + 8);

    const barsHtml = t.bins.map((b, i) => {
      const h = maxCount ? Math.max(2, Math.round((b.count / maxCount) * 100)) : 2;
      return `<div class="dist-bar-col${i === bestIdx ? ' is-best' : ''}" data-i="${i}" style="min-width:${colW}px">
        <div class="dist-bar" style="height:${h}%"></div>
      </div>`;
    }).join('');

    const axisHtml = t.bins.map(b => `<div class="dist-axis-label" style="min-width:${colW}px">${b.label}</div>`).join('');

    const pctNote = DIST_DESCENDING
      ? 'percentile = midpoint of % of samples at-or-above this bin\u2019s range (fewer cycles = better)'
      : 'percentile = midpoint of % of samples at-or-below this bin\u2019s range';

    bodyEl.innerHTML = `
      <div class="dist-meta-row">
        <div class="dist-meta-chip"><span class="v">${t.total.toLocaleString()}</span><div class="l">Samples</div></div>
        <div class="dist-meta-chip"><span class="v">${t.bins.length}</span><div class="l">Bins</div></div>
        <div class="dist-meta-chip"><span class="v">${fmtScore(minScore)}</span><div class="l">Min ${DIST_UNIT}</div></div>
        <div class="dist-meta-chip"><span class="v">${fmtScore(maxScore)}</span><div class="l">Max ${DIST_UNIT}</div></div>
        ${t.meta}
      </div>
      <div class="dist-chart-wrap">
        <div class="dist-chart">${barsHtml}</div>
        <div class="dist-axis-row">${axisHtml}</div>
        <div class="dist-axis-note">${DIST_UNIT} (x-axis, ${DIST_DESCENDING ? 'highest → lowest — best on the right' : 'lowest → highest'}) · bar height = frequency · hover a bar for its percentile (${pctNote})</div>
      </div>
    `;

    bodyEl.querySelectorAll('.dist-bar-col').forEach(col => {
      const i = parseInt(col.dataset.i, 10);
      const b = t.bins[i];
      col.addEventListener('mousemove', (e) => {
        tooltipEl.style.display = 'block';
        tooltipEl.style.left = (e.clientX + 14) + 'px';
        tooltipEl.style.top  = (e.clientY + 14) + 'px';
        tooltipEl.innerHTML = `<b>${b.label}</b> ${DIST_UNIT}<br>Count: ${b.count.toLocaleString()} (${b.pctOfTotal.toFixed(1)}% of samples)<br><span class="pct">Percentile: ${b.percentile.toFixed(1)}</span>`;
      });
      col.addEventListener('mouseleave', () => { tooltipEl.style.display = 'none'; });
    });
  }

  if (reopenBtn) {
    reopenBtn.addEventListener('click', () => {
      window.reopenDistribution();
      syncBadge();
    });
  }

  if (clearAllBtn) clearAllBtn.addEventListener('click', closeAllTabs);

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal(); });
})();
</script>
