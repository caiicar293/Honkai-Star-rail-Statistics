<script>
// ── Previous-version difference (Prydwen-style ▲/▼ vs the earlier version) ──
// Shared by the character templates. The page calls PrevDiff.configure(...)
// once, then PrevDiff.onLoaded(filename) every time a dataset finishes
// loading (first load AND version switches), and renders each metric through
// PrevDiff.delta(row, metricKey, decimals) / PrevDiff.newBadge(row).
//
// Turning the "Show previous version difference" button on lazily fetches the
// data of the next-older version from the same versions manifest the version
// switcher uses, matches rows by a page-supplied key, and shows the change
// next to every metric:
//   green ▲/▼ = the metric improved, red ▲/▼ = it got worse,
//   grey  ▲/▼ = a neutral metric (samples, sustain, σ, eidolon mix).
// "Improved" for score metrics depends on the mode (lower is better in
// MOC / Anomaly, higher in Apoc / Pure Fiction) — see META + cfg.lowerIsBetter.
const PrevDiff = (() => {
  // metric key -> how to colour a change:
  //   'score' → better = lower in MOC/Anomaly, higher in Apoc/PF
  //   1       → higher is better (usage, full-star rate)
  //   0       → neutral (population size, sustain, spread, eidolon mix)
  const META = {
    Appearance_Rate_pct: 1, Full_Clear_Rate_pct: 1,
    Min_Score: 'score', Percentile_25: 'score', Median_Score: 'score',
    Percentile_75: 'score', Average_Score: 'score', Max_Score: 'score',
    Samples: 0, Sustain_Samples: 0, Sustain_Percentage: 0, Total_Full_Clears: 0,
    Std_Dev: 0, Eidolon_0_pct: 0, Eidolon_6_pct: 0,
  };

  let cfg = null;
  let manifest = null;   // [{label, safe}] newest-first; [] if it could not be fetched
  let curSafe = null;    // version currently shown, e.g. "4_5_1"
  let prev = null;       // { label, safe, maps: { datasetName: Map | null } } | null
  let wantOn = false;    // the user's toggle
  let busy = false;
  let failed = false;
  let token = 0;         // cancels stale async work when the user toggles / switches version
  const cache = new Map();

  function safeFrom(filename) {
    const m = String(filename).match(new RegExp('^' + cfg.prefix + '_(\\d+(?:_\\d+)*)_'));
    return m ? m[1] : null;
  }

  async function loadManifest() {
    if (manifest) return manifest;
    try {
      const res = await fetch(cfg.manifest);
      manifest = res.ok ? await res.json() : [];
    } catch (e) {
      manifest = [];
    }
    if (!Array.isArray(manifest)) manifest = [];
    return manifest;
  }

  function findPrev() {
    if (!manifest || !curSafe) return null;
    const i = manifest.findIndex(v => v.safe === curSafe);
    return (i >= 0 && i + 1 < manifest.length) ? manifest[i + 1] : null;
  }

  async function fetchRows(filename) {
    const res = await fetch(filename);
    if (!res.ok) throw new Error('Failed to fetch ' + filename);
    const buf = await res.arrayBuffer();
    const brotli = await getBrotli();
    return JSON.parse(new TextDecoder().decode(brotli.decompress(new Uint8Array(buf))));
  }

  // Keep only the metrics we diff — the old version's score distributions etc.
  // would just sit in memory. Eidolon %s arrive as "<key>_pct" on raw rows.
  function slim(row) {
    const o = {};
    for (const k in META) o[k] = row[k] != null ? row[k] : (row[k + '_pct'] != null ? row[k + '_pct'] : null);
    return o;
  }

  async function loadPrev() {
    const info = findPrev();
    if (!info) return null;
    if (cache.has(info.safe)) return cache.get(info.safe);
    const maps = {};
    let ok = 0;
    await Promise.all(Object.entries(cfg.datasets).map(async ([name, ds]) => {
      try {
        const rows = await fetchRows(ds.filenameFor(info.safe));
        const m = new Map();
        for (const r of rows) m.set(ds.keyOf(r), slim(r));
        maps[name] = m;
        ok++;
      } catch (e) {
        console.warn('Previous-version dataset unavailable:', name, e);
        maps[name] = null;
      }
    }));
    if (!ok) throw new Error('No previous-version data could be loaded');
    const result = { label: info.label, safe: info.safe, maps };
    if (cache.size >= 2) cache.clear();
    cache.set(info.safe, result);
    return result;
  }

  function annotate() {
    for (const [name, ds] of Object.entries(cfg.datasets)) {
      const map = prev && prev.maps[name];
      for (const r of (ds.rows() || [])) {
        r._pdOk   = !!map;
        r._prev   = map ? (map.get(ds.keyOf(r)) || null) : null;
      }
    }
  }

  function syncUi() {
    const btn    = document.getElementById('prevDiffBtn');
    const legend = document.getElementById('prevDiffLegend');
    const noPrev = !!manifest && !findPrev();
    const active = wantOn && !!prev && !busy;
    if (btn) {
      btn.disabled = busy || noPrev;
      btn.classList.toggle('active', wantOn && !noPrev);
      btn.setAttribute('aria-pressed', String(active));
      btn.textContent = busy ? 'Loading previous version…'
        : noPrev ? 'No earlier version to compare'
        : failed ? 'Couldn\u2019t load previous version — retry'
        : wantOn ? 'Hide previous version difference'
        : 'Show previous version difference';
    }
    if (legend) {
      if (active) {
        legend.hidden = false;
        legend.innerHTML =
          `<span>vs <b>${prev.label}</b></span>` +
          `<span><span class="pd-delta pd-good">▲▼</span> improved</span>` +
          `<span><span class="pd-delta pd-bad">▲▼</span> worse</span>` +
          `<span><span class="pd-delta pd-neutral">▲▼</span> neutral (samples, sustain, σ, eidolon mix)</span>` +
          `<span>scores: ${cfg.lowerIsBetter ? 'lower' : 'higher'} is better</span>` +
          `<span><span class="pd-new">NEW</span> not in ${prev.label}</span>`;
      } else {
        legend.hidden = true;
      }
    }
  }

  async function ensure() {
    if (!wantOn) { syncUi(); return; }
    const tok = ++token;
    busy = true; syncUi();
    try {
      await loadManifest();
      const p = await loadPrev();
      if (tok !== token) return;
      prev = p;
      annotate();
      failed = false;
    } catch (err) {
      if (tok !== token) return;
      console.warn('Previous-version load failed:', err);
      prev = null; wantOn = false; failed = true;
    }
    busy = false;
    syncUi();
  }

  async function toggle() {
    if (busy) return;
    if (wantOn) {
      wantOn = false; token++;
      syncUi();
      cfg.onChange();
      return;
    }
    wantOn = true; failed = false;
    await ensure();
    cfg.onChange();
  }

  // Call after every dataset (re)load. Rows are fresh objects at this point,
  // so if the diff is on we re-fetch/annotate against the new version's predecessor.
  async function onLoaded(filename) {
    try {
      curSafe = safeFrom(filename);
      prev = null;
      await loadManifest();
      if (wantOn) await ensure(); else syncUi();
    } catch (err) {
      // never let the comparison feature break the page's own data load
      console.warn('PrevDiff.onLoaded failed:', err);
    }
  }

  function delta(r, key, dec) {
    if (!wantOn || !prev || !r._prev) return '';
    const cur = r[key], old = r._prev[key];
    if (cur == null || old == null || isNaN(cur) || isNaN(old)) return '';
    const fmtAbs = v => dec === 0 ? Math.abs(v).toLocaleString() : Math.abs(v).toFixed(dec);
    const oldTxt = dec === 0 ? old.toLocaleString() : old.toFixed(dec);
    const tip    = `vs ${prev.label}: ${oldTxt}`;
    const shown  = Number((cur - old).toFixed(dec));
    if (shown === 0) return `<span class="pd-delta pd-flat" title="${tip} (unchanged)">=</span>`;
    const up   = shown > 0;
    const kind = META[key];
    let cls = 'pd-neutral';
    if (kind) {
      const sign = kind === 'score' ? (cfg.lowerIsBetter ? -1 : 1) : kind;
      cls = (up ? sign > 0 : sign < 0) ? 'pd-good' : 'pd-bad';
    }
    return `<span class="pd-delta ${cls}" title="${tip}">${up ? '▲' : '▼'}${fmtAbs(shown)}</span>`;
  }

  function newBadge(r) {
    if (!wantOn || !prev || !r._pdOk || r._prev) return '';
    return `<span class="pd-new" title="No matching row in ${prev.label}">NEW</span>`;
  }

  function configure(c) {
    cfg = c;
    const btn = document.getElementById('prevDiffBtn');
    if (btn) btn.addEventListener('click', toggle);
  }

  return { configure, onLoaded, delta, newBadge };
})();
</script>
