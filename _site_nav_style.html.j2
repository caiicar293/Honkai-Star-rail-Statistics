  /* ── Shared site navigation (floating, hidden by default) ─────────────── */
  /* Self-contained: defines its own colours so it looks the same on every
     page regardless of that page's theme variables. */
  .site-nav {
    --sn-bg: #141c2e; --sn-bg2: #1a2338; --sn-border: #243552;
    --sn-accent: #38bdf8; --sn-text: #e2eaf6; --sn-text2: #8fa3c0;
    --sn-text3: #506070; --sn-teal: #2dd4bf;
  }
  .site-nav-fab {
    position: fixed; right: 16px; bottom: 16px; z-index: 940;
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--sn-bg); border: 1px solid var(--sn-border); color: var(--sn-accent);
    font-family: 'Rajdhani', 'Inter', sans-serif; font-size: 14px; font-weight: 700;
    letter-spacing: 0.03em; padding: 9px 14px; border-radius: 22px; cursor: pointer;
    box-shadow: 0 8px 24px rgba(0,0,0,0.45);
    transition: border-color 0.15s, background 0.15s, transform 0.12s;
  }
  .site-nav-fab:hover { border-color: var(--sn-accent); background: rgba(56,189,248,0.1); transform: translateY(-1px); }
  .site-nav-fab svg { width: 16px; height: 16px; flex-shrink: 0; }
  .site-nav-fab[aria-expanded="true"] { border-color: var(--sn-accent); background: rgba(56,189,248,0.14); }
  .site-nav-panel {
    position: fixed; right: 16px; bottom: 68px; z-index: 941;
    width: 244px; max-height: min(70vh, 540px); overflow-y: auto;
    background: var(--sn-bg2); border: 1px solid var(--sn-border); border-radius: 10px;
    box-shadow: 0 16px 44px rgba(0,0,0,0.6); padding: 10px;
  }
  .site-nav-panel[hidden] { display: none; }
  .site-nav-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  .site-nav-title { font-family: 'Share Tech Mono', 'Inter', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sn-text3); }
  .site-nav-close { background: none; border: none; color: var(--sn-text3); font-size: 18px; line-height: 1; cursor: pointer; padding: 0 2px; }
  .site-nav-close:hover { color: var(--sn-text); }
  .site-nav-home {
    display: flex; align-items: center; gap: 8px; margin-bottom: 10px;
    background: rgba(56,189,248,0.08); border: 1px solid rgba(56,189,248,0.3); color: var(--sn-accent);
    border-radius: 7px; padding: 9px 10px; text-decoration: none;
    font-family: 'Rajdhani', 'Inter', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.03em;
  }
  .site-nav-home:hover { background: rgba(56,189,248,0.15); }
  .site-nav-home svg { width: 15px; height: 15px; flex-shrink: 0; }
  .site-nav-group { margin-top: 10px; }
  .site-nav-group-label { font-family: 'Share Tech Mono', 'Inter', monospace; font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sn-text3); margin-bottom: 5px; }
  .site-nav-link {
    display: block; padding: 6px 9px; border-radius: 6px; text-decoration: none;
    color: var(--sn-text2); font-family: 'Exo 2', 'Inter', sans-serif; font-size: 12.5px;
    transition: background 0.12s, color 0.12s;
  }
  .site-nav-link:hover { background: rgba(56,189,248,0.09); color: var(--sn-accent); }
  .site-nav-link.is-current { color: var(--sn-teal); }
  @media (max-width: 520px) { .site-nav-fab-label { display: none; } }
