<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Dynamic By-Cost Archetype Tier List — {{ version_label }}</title>
<link rel="icon" type="image/jpeg" href="../favicon.jpg"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Exo+2:wght@300;400;600;800&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #090c14; --bg2: #0d1220;
    --panel: #141c2e; --panel2: #1a2338;
    --border: #1e2d47; --border2: #243552;
    --accent: #38bdf8; --accent2: #7dd3fc;
    --gold: #fbbf24; --teal: #2dd4bf;
    --purple: #a78bfa; --red: #f87171; --green: #4ade80;
    --orange: #fb923c;
    --muted: #4a5d7a;
    --text: #e2eaf6; --text2: #8fa3c0; --text3: #506070;
    --e0: #94a3b8; --e1: #4ade80; --e2: #38bdf8; --e6: #fbbf24;
    --t0: #f87171; --t05: #fb923c; --t1: #fbbf24; --t15: #a3e635; --t2: #4ade80;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Exo 2', sans-serif; min-height: 100vh; overflow-x: hidden; }
  body::before {
    content: ''; position: fixed; inset: 0;
    background-image: linear-gradient(rgba(56,189,248,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(56,189,248,0.03) 1px, transparent 1px);
    background-size: 40px 40px; pointer-events: none; z-index: 0;
  }
  .container { position: relative; z-index: 1; max-width: 1800px; margin: 0 auto; padding: 24px; }

  /* HEADER */
  .header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22px; padding-bottom: 20px; border-bottom: 1px solid var(--border); gap: 20px; flex-wrap: wrap; }
  .header-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(56,189,248,0.08); border: 1px solid rgba(56,189,248,0.25); border-radius: 4px; padding: 3px 10px; font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--accent); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 8px; }
  .header-badge::before { content: '●'; font-size: 7px; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .header h1 { font-family: 'Rajdhani', sans-serif; font-size: 34px; font-weight: 700; letter-spacing: 0.05em; line-height: 1.1; }
  .header h1 span { color: var(--accent); }
  .header-sub { font-size: 13px; color: var(--text2); margin-top: 5px; font-family: 'Share Tech Mono', monospace; letter-spacing: 0.05em; }
  .header-meta { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .meta-chip { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 8px 14px; text-align: center; min-width: 84px; }
  .meta-chip .val { font-family: 'Rajdhani', sans-serif; font-size: 20px; font-weight: 700; color: var(--accent); display: block; line-height: 1; }
  .meta-chip .lbl { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 3px; }

  /* CATEGORY TABS (Archetypes / Sustains / Amplifiers) */
  .category-tabs { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .category-tab {
    background: var(--panel2); border: 1.5px solid var(--border2); color: var(--text2);
    font-family: 'Rajdhani', sans-serif; font-size: 15px; font-weight: 700; letter-spacing: 0.05em;
    padding: 10px 20px; border-radius: 8px; cursor: pointer; transition: all 0.15s; text-transform: uppercase;
  }
  .category-tab:hover { border-color: var(--accent2); color: var(--accent2); }
  .category-tab.active { background: rgba(56,189,248,0.14); border-color: var(--accent); color: var(--accent); box-shadow: 0 0 14px rgba(56,189,248,0.2); }

  /* MODE TABS */
  .mode-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px; }
  .mode-tab {
    background: var(--panel); border: 1px solid var(--border); color: var(--text2);
    font-family: 'Rajdhani', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.04em;
    padding: 8px 16px; border-radius: 6px; cursor: pointer; transition: all 0.15s;
  }
  .mode-tab:hover { border-color: var(--accent); color: var(--accent); }
  .mode-tab.active { background: rgba(56,189,248,0.12); border-color: var(--accent); color: var(--accent); box-shadow: 0 0 12px rgba(56,189,248,0.15); }

  /* CONTROLS */
  .controls { display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; align-items: flex-end; }
  .ctrl-group { display: flex; flex-direction: column; gap: 5px; }
  .ctrl-label { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.1em; font-family: 'Share Tech Mono', monospace; }
  .btn-group { display: flex; gap: 4px; flex-wrap: wrap; }
  .btn-toggle { background: var(--panel); border: 1px solid var(--border); color: var(--text2); font-family: 'Rajdhani', sans-serif; font-size: 13px; font-weight: 600; padding: 5px 11px; border-radius: 5px; cursor: pointer; transition: all 0.15s; letter-spacing: 0.04em; white-space: nowrap; }
  .btn-toggle:hover { border-color: var(--accent); color: var(--accent); }

  .btn-toggle.meid.e0.active { border-color: var(--e0);    color: var(--e0);    background: rgba(148,163,184,0.08); }
  .btn-toggle.meid.e1.active { border-color: var(--e1);    color: var(--e1);    background: rgba(74,222,128,0.07); }
  .btn-toggle.meid.e2.active { border-color: var(--e2);    color: var(--e2);    background: rgba(56,189,248,0.08); }
  .btn-toggle.meid.e3.active { border-color: var(--purple); color: var(--purple); background: rgba(167,139,250,0.08); }
  .btn-toggle.meid.e4.active { border-color: var(--orange); color: var(--orange); background: rgba(251,146,60,0.08); }
  .btn-toggle.meid.e5.active { border-color: var(--red);   color: var(--red);   background: rgba(248,113,113,0.08); }
  .btn-toggle.meid.e6.active { border-color: var(--e6);    color: var(--e6);    background: rgba(251,191,36,0.09); }

  .btn-toggle.sustain-yes.active { border-color: var(--green); color: var(--green); background: rgba(74,222,128,0.1); }
  .btn-toggle.sustain-no.active  { border-color: var(--red);   color: var(--red);   background: rgba(248,113,113,0.1); }

  .search-wrap { position: relative; min-width: 240px; max-width: 400px; flex: 1; }
  .search-wrap svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text3); pointer-events: none; width:14px; height:14px; }
  #searchInput { width: 100%; background: var(--panel); border: 1px solid var(--border); border-radius: 5px; color: var(--text); font-family: 'Exo 2', sans-serif; font-size: 13px; padding: 7px 12px 7px 32px; outline: none; transition: border-color 0.15s; }
  #searchInput:focus { border-color: var(--accent); }
  #searchInput::placeholder { color: var(--text3); }

  /* Cost panel */
  .cost-panel {
    background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
    padding: 14px 16px; margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-end;
  }
  .cost-panel-title { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.1em; font-family: 'Share Tech Mono', monospace; width: 100%; margin-bottom: 2px; }
  .cost-range-group { display: flex; flex-direction: column; gap: 6px; min-width: 200px; flex: 1; }
  .cost-range-label { font-size: 11px; color: var(--text2); font-family: 'Share Tech Mono', monospace; display: flex; justify-content: space-between; }
  .cost-range-label span { color: var(--accent); font-weight: 700; }
  input[type="range"] {
    -webkit-appearance: none; width: 100%; height: 4px; border-radius: 2px;
    background: linear-gradient(90deg, var(--accent) var(--fill, 0%), var(--border2) var(--fill, 0%));
    outline: none; cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%;
    background: var(--accent); border: 2px solid var(--bg); cursor: pointer;
    box-shadow: 0 0 6px rgba(56,189,248,0.5);
  }
  input[type="range"]::-moz-range-thumb {
    width: 14px; height: 14px; border-radius: 50%; background: var(--accent);
    border: 2px solid var(--bg); cursor: pointer; box-shadow: 0 0 6px rgba(56,189,248,0.5);
  }
  .cost-presets { display: flex; gap: 6px; flex-wrap: wrap; align-items: flex-end; }
  .cost-preset-btn {
    background: var(--bg2); border: 1px solid var(--border); color: var(--text3);
    font-family: 'Share Tech Mono', monospace; font-size: 10px; font-weight: 700;
    border-radius: 4px; padding: 4px 9px; cursor: pointer; transition: all 0.15s; white-space: nowrap;
  }
  .cost-preset-btn:hover, .cost-preset-btn.active { border-color: var(--teal); color: var(--teal); background: rgba(45,212,191,0.07); }
  .cost-panel.locked { opacity: 0.45; pointer-events: none; position: relative; }
  .cost-panel-lock-note { width: 100%; font-size: 11px; color: var(--accent); font-family: 'Share Tech Mono', monospace; letter-spacing: 0.05em; margin-top: -4px; }

  /* RANKING MODE TABS (Tier List vs Cost Efficiency) */
  .ranking-mode-tabs { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .ranking-mode-tab {
    background: var(--panel2); border: 1.5px solid var(--border2); color: var(--text2);
    font-family: 'Rajdhani', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.05em;
    padding: 9px 18px; border-radius: 8px; cursor: pointer; transition: all 0.15s; text-transform: uppercase;
  }
  .ranking-mode-tab:hover { border-color: var(--teal); color: var(--teal); }
  .ranking-mode-tab.active { background: rgba(45,212,191,0.14); border-color: var(--teal); color: var(--teal); box-shadow: 0 0 14px rgba(45,212,191,0.2); }

  /* EFFICIENCY PANEL */
  .efficiency-panel {
    background: var(--panel); border: 1px solid var(--teal); border-radius: 8px;
    padding: 14px 16px; margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-end;
  }
  .efficiency-panel-title { font-size: 10px; color: var(--teal); text-transform: uppercase; letter-spacing: 0.1em; font-family: 'Share Tech Mono', monospace; width: 100%; margin-bottom: 2px; }
  .efficiency-target-group { display: flex; flex-direction: column; gap: 6px; min-width: 200px; }
  .efficiency-target-group input[type="number"] {
    width: 140px; background: var(--bg2); border: 1px solid var(--border2); color: var(--text);
    font-family: 'Share Tech Mono', monospace; font-size: 13px; padding: 6px 10px; border-radius: 4px; outline: none;
  }
  .efficiency-target-group input[type="number"]:focus { border-color: var(--teal); }

  /* COST TIER EDITOR (inside Tier Settings panel) */
  .cost-tier-row { display: flex; align-items: center; gap: 6px; font-family: 'Share Tech Mono', monospace; font-size: 11.5px; }
  .cost-tier-row label { width: 62px; color: var(--text2); flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cost-tier-row input[type="number"] {
    width: 62px; background: var(--bg2); border: 1px solid var(--border2); color: var(--text);
    font-family: 'Share Tech Mono', monospace; font-size: 11.5px; padding: 4px 6px; border-radius: 4px; outline: none;
  }
  .cost-tier-row input[type="number"]:focus { border-color: var(--teal); }
  .cost-tier-row span.dash { color: var(--text3); }

  /* EFFICIENCY RESULTS LIST -- grouped into Cost Efficiency Tier brackets
     (same labels/ranges as the Cost Tier Presets editor in Tier Settings) */
  .efficiency-tier-list { display: flex; flex-direction: column; gap: 10px; }
  .efficiency-tier-row { display: flex; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--panel); box-shadow: 0 4px 30px rgba(0,0,0,0.35); }
  .efficiency-tier-label-wrap { width: 108px; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; padding: 10px 6px; text-align: center; }
  .efficiency-tier-label { font-family: 'Rajdhani', sans-serif; font-size: 16px; font-weight: 800; color: #0a0e18; text-transform: uppercase; letter-spacing: 0.03em; line-height: 1.15; }
  .efficiency-tier-range { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: rgba(10,14,24,0.8); }
  .efficiency-tier-count { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: rgba(10,14,24,0.65); text-transform: uppercase; letter-spacing: 0.05em; }
  .efficiency-tier-content { display: flex; flex-direction: column; gap: 8px; padding: 14px; flex-grow: 1; }
  .efficiency-tier-content:empty::after { content: 'No entries reach the target score in this cost bracket'; color: var(--text3); font-family: 'Share Tech Mono', monospace; font-size: 12px; padding: 10px; }
  .efficiency-row {
    display: flex; align-items: center; gap: 14px; background: var(--panel2); border: 1px solid var(--border2);
    border-radius: 8px; padding: 10px 16px;
  }
  .efficiency-rank {
    font-family: 'Rajdhani', sans-serif; font-size: 20px; font-weight: 800; color: var(--teal);
    width: 34px; flex-shrink: 0; text-align: center;
  }
  .efficiency-row .arch-card-icons { flex-shrink: 0; }
  .efficiency-row .arch-card-name { flex: 1; min-width: 120px; }
  .efficiency-row .arch-card-stats { flex-shrink: 0; }
  .stat-pill.cost-hero { color: var(--bg); background: var(--teal); border-color: var(--teal); font-weight: 700; }

  /* TIER SETTINGS PANEL */
  /* VERSION HISTORY NAV */
  .version-panel {
    background: var(--panel); border: 1px solid var(--border2); border-radius: 8px;
    padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  }
  .version-panel-title { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.1em; font-family: 'Share Tech Mono', monospace; width: 100%; margin-bottom: 2px; }
  .version-nav-controls { display: flex; align-items: center; gap: 6px; }
  .version-nav-btn {
    background: var(--bg2); border: 1px solid var(--border2); color: var(--text2);
    font-family: 'Rajdhani', sans-serif; font-size: 15px; font-weight: 700; width: 30px; height: 30px;
    border-radius: 5px; cursor: pointer; transition: all 0.15s; display: flex; align-items: center; justify-content: center;
  }
  .version-nav-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .version-nav-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  select#versionSelect {
    background: var(--bg2); border: 1px solid var(--border2); color: var(--text); font-family: 'Share Tech Mono', monospace;
    font-size: 12px; padding: 7px 10px; border-radius: 5px; outline: none; min-width: 260px; cursor: pointer;
  }
  select#versionSelect:focus { border-color: var(--accent); }
  .version-window-note { font-size: 11px; color: var(--text3); font-family: 'Share Tech Mono', monospace; }
  .version-window-note .live-tag { color: var(--teal); font-weight: 700; }
  .version-loading-tag { display: none; font-size: 11px; color: var(--accent); font-family: 'Share Tech Mono', monospace; letter-spacing: 0.06em; }
  .version-loading-tag.active { display: inline-flex; align-items: center; gap: 6px; }
  .version-loading-tag .spin { width: 10px; height: 10px; border: 2px solid var(--accent); border-top-color: transparent; border-radius: 50%; animation: spin 0.7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .settings-toggle {
    display: inline-flex; align-items: center; gap: 8px; background: var(--panel); border: 1px solid var(--border2);
    color: var(--text2); font-family: 'Share Tech Mono', monospace; font-size: 11px; letter-spacing: 0.08em;
    padding: 8px 14px; border-radius: 6px; cursor: pointer; margin-bottom: 12px; text-transform: uppercase;
  }
  .settings-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .settings-toggle .chev { transition: transform 0.15s; display:inline-block; }
  .settings-toggle.open .chev { transform: rotate(90deg); }

  .settings-panel {
    display: none; background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 18px 20px; margin-bottom: 18px; gap: 22px; flex-wrap: wrap;
  }
  .settings-panel.open { display: flex; }
  .settings-col { display: flex; flex-direction: column; gap: 10px; min-width: 200px; }
  .settings-col.wide { min-width: 340px; flex: 1; }
  select#metricSelect {
    background: var(--bg2); border: 1px solid var(--border2); color: var(--text); font-family: 'Share Tech Mono', monospace;
    font-size: 12px; padding: 7px 10px; border-radius: 5px; outline: none;
  }
  .threshold-row { display: flex; align-items: center; gap: 8px; font-family: 'Share Tech Mono', monospace; font-size: 12px; }
  .threshold-row label { width: 58px; color: var(--text2); }
  .threshold-row input[type="number"] {
    width: 100px; background: var(--bg2); border: 1px solid var(--border2); color: var(--text);
    font-family: 'Share Tech Mono', monospace; font-size: 12px; padding: 5px 8px; border-radius: 4px; outline: none;
  }
  .threshold-row input[type="number"]:focus { border-color: var(--accent); }
  .threshold-row .tswatch { width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0; }
  .direction-note { font-size: 11px; color: var(--text3); font-style: italic; }
  .reset-btn {
    align-self: flex-start; background: var(--bg2); border: 1px solid var(--border2); color: var(--text2);
    font-family: 'Share Tech Mono', monospace; font-size: 11px; padding: 6px 12px; border-radius: 5px; cursor: pointer;
  }
  .reset-btn:hover { border-color: var(--red); color: var(--red); }

  .results-info { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--text3); padding: 4px 0 14px; letter-spacing: 0.06em; }
  .results-info span { color: var(--accent); }

  /* TIER LIST */
  .tier-list { display: flex; flex-direction: column; gap: 10px; }
  .tier-row { display: flex; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--panel); box-shadow: 0 4px 30px rgba(0,0,0,0.35); }
  .tier-label-wrap { width: 96px; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; padding: 10px 6px; }
  .tier-label { font-family: 'Rajdhani', sans-serif; font-size: 26px; font-weight: 800; color: #0a0e18; text-align: center; line-height: 1; }
  .tier-count { font-family: 'Share Tech Mono', monospace; font-size: 10px; color: rgba(10,14,24,0.65); text-transform: uppercase; letter-spacing: 0.05em; }
  .tier-T0     .tier-label-wrap { background: var(--t0); }
  .tier-T0\.5  .tier-label-wrap { background: var(--t05); }
  .tier-T1     .tier-label-wrap { background: var(--t1); }
  .tier-T1\.5  .tier-label-wrap { background: var(--t15); }
  .tier-T2     .tier-label-wrap { background: var(--t2); }

  .tier-content { display: flex; flex-wrap: wrap; gap: 12px; padding: 14px; flex-grow: 1; align-items: stretch; align-content: flex-start; }
  .tier-content:empty::after { content: 'No entries in this tier under current filters'; color: var(--text3); font-family: 'Share Tech Mono', monospace; font-size: 12px; padding: 10px; }

  .arch-card {
    display: flex; flex-direction: column; gap: 7px; background: var(--panel2); border: 1px solid var(--border2);
    border-radius: 8px; padding: 10px 12px; min-width: 190px; max-width: 230px; transition: border-color 0.15s;
  }
  .arch-card:hover { border-color: var(--accent); }
  .arch-card-icons { display: flex; align-items: center; }
  .char-icon { width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--border2); object-fit: cover; margin-left: -8px; background: var(--bg2); }
  .char-icon:first-child { margin-left: 0; }
  .char-icon-placeholder { width: 32px; height: 32px; border-radius: 50%; background: var(--bg2); border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--text3); margin-left: -8px; flex-shrink: 0; }
  .char-icon-placeholder:first-child { margin-left: 0; }
  .arch-card-name { font-size: 12.5px; font-weight: 600; color: var(--text); line-height: 1.25; }
  .arch-card-stats { display: flex; flex-wrap: wrap; gap: 5px; font-family: 'Share Tech Mono', monospace; font-size: 10.5px; }
  .stat-pill { background: var(--bg2); border: 1px solid var(--border); border-radius: 4px; padding: 2px 6px; color: var(--text2); white-space: nowrap; }
  .stat-pill.score { color: var(--gold); border-color: rgba(251,191,36,0.3); }
  .stat-pill.rate  { color: var(--accent2); border-color: rgba(56,189,248,0.3); }
  .stat-pill.sustain-hi { color: var(--green); border-color: rgba(74,222,128,0.3); }
  .stat-pill.sustain-lo { color: var(--red); border-color: rgba(248,113,113,0.3); }
  .stat-pill.cost { color: var(--teal); border-color: rgba(45,212,191,0.3); }
  .stat-pill.eid { color: var(--purple); border-color: rgba(167,139,250,0.3); }
  .stat-pill.full-star { color: var(--gold); border-color: rgba(251,191,36,0.3); }

  .unranked-note { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--text3); text-align: center; padding: 14px; border: 1px dashed var(--border2); border-radius: 8px; margin-top: 4px; }

  .empty-state { text-align: center; padding: 60px 20px; color: var(--text3); }
  .empty-state .icon { font-size: 40px; margin-bottom: 10px; }
  .empty-state p { font-family: 'Share Tech Mono', monospace; font-size: 13px; }

  #particleCanvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: 0.8; }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg2); }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

  /* MOBILE OVERFLOW FIXES -- the version-window-note and versions meta-chip
     are single long strings (per-mode version breakdown) that otherwise
     force horizontal overflow on narrow screens instead of wrapping. */
  @media (max-width: 640px) {
    .container { padding: 16px 12px; }
    .header { gap: 12px; }
    .header h1 { font-size: 26px; }
    .header-meta { width: 100%; gap: 8px; }
    .meta-chip { flex: 1 1 calc(50% - 8px); min-width: 0; max-width: none; }
    .meta-chip .val { font-size: 13px; white-space: normal; word-break: break-word; overflow-wrap: break-word; }

    .category-tab { padding: 7px 12px; font-size: 12px; }
    .mode-tab { padding: 6px 11px; font-size: 12px; }

    .version-panel { flex-direction: column; align-items: stretch; gap: 8px; }
    .version-nav-controls { width: 100%; }
    select#versionSelect { flex: 1 1 auto; min-width: 0; max-width: none; }
    .version-window-note, .version-panel-title { width: 100%; white-space: normal; word-break: break-word; overflow-wrap: break-word; }

    .controls { gap: 10px; }
    .cost-panel { padding: 12px; gap: 12px; }
  }
</style>
</head>
<body>
<canvas id="particleCanvas" aria-hidden="true"></canvas>
<div class="container">

  <div class="header">
    <div class="header-left">
      <div class="header-badge">Dynamic Tier List · By Cost</div>
      <h1>By-Cost Archetype <span>Tier List</span></h1>
      <div class="header-sub">{{ subtitle }} · Tiers computed live in-browser from configurable thresholds</div>
    </div>
    <div class="header-meta">
      <div class="meta-chip"><span class="val" id="visibleCount">—</span><div class="lbl">Ranked</div></div>
      <div class="meta-chip"><span class="val" id="hiddenCount">—</span><div class="lbl">Below Min App.</div></div>
      <div class="meta-chip"><span class="val" id="costRangeDisplay">—</span><div class="lbl">Cost Range</div></div>
      <div class="meta-chip"><span class="val" id="versionsChip">{{ version_label }}</span><div class="lbl">Versions</div></div>
    </div>
  </div>

  <div class="category-tabs" id="categoryTabs">
    <button class="category-tab active" data-category="archetype">🧩 Archetypes</button>
    <button class="category-tab" data-category="sustain">🛡️ Sustains</button>
    <button class="category-tab" data-category="amplifier">⚡ Amplifiers</button>
  </div>

  <div class="ranking-mode-tabs" id="rankingModeTabs">
    <button class="ranking-mode-tab active" data-ranking-mode="tier">🏆 Tier List</button>
    <button class="ranking-mode-tab" data-ranking-mode="efficiency">💰 Cost Efficiency</button>
  </div>

  <div class="mode-tabs" id="modeTabs"></div>

  <div class="version-panel" id="versionPanel">
    <div class="version-panel-title">Past Rankings — browse rolling 3-version-window snapshots</div>
    <div class="version-nav-controls">
      <button class="version-nav-btn" id="verPrevBtn" title="Older snapshot">◀</button>
      <select id="versionSelect"></select>
      <button class="version-nav-btn" id="verNextBtn" title="Newer snapshot">▶</button>
    </div>
    <div class="version-window-note" id="versionWindowNote"></div>
    <div class="version-loading-tag" id="versionLoadingTag"><span class="spin"></span> Loading snapshot…</div>
  </div>

  <div class="controls">
    <div class="ctrl-group">
      <div class="ctrl-label">Max Eidolon in Archetype</div>
      <div class="btn-group" id="meidFilters">
        <button class="btn-toggle meid e0 active" data-meid="0">E0</button>
        <button class="btn-toggle meid e1 active" data-meid="1">E1</button>
        <button class="btn-toggle meid e2 active" data-meid="2">E2</button>
        <button class="btn-toggle meid e3 active" data-meid="3">E3</button>
        <button class="btn-toggle meid e4 active" data-meid="4">E4</button>
        <button class="btn-toggle meid e5 active" data-meid="5">E5</button>
        <button class="btn-toggle meid e6 active" data-meid="6">E6</button>
      </div>
    </div>

    <div class="ctrl-group">
      <div class="ctrl-label">Sustain Presence</div>
      <div class="btn-group">
        <button class="btn-toggle sustain-yes active" id="sustainYesBtn">+ Sustain</button>
        <button class="btn-toggle sustain-no active" id="sustainNoBtn">✕ No Sustain</button>
      </div>
    </div>

    <div class="ctrl-group" style="flex:1; min-width:240px; max-width:420px;">
      <div class="ctrl-label">Search (name or Acheron(E2) for exact eid)</div>
      <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="searchInput" type="text" placeholder="Acheron · Acheron(E2) · Robin(E0)…"/>
      </div>
    </div>
  </div>

  <div class="cost-panel" id="costPanel">
    <div class="cost-panel-title">Cost Range — filter by estimated_min_cost and estimated_max_cost (sliding window buckets)</div>
    <div class="cost-panel-lock-note" id="costPanelLockNote" style="display:none;">🔒 Locked to All while Cost Efficiency mode is active — it ranks across the whole cost range by design.</div>
    <div class="cost-range-group">
      <div class="cost-range-label">Min Cost ≥ <span id="minCostLabel">0</span></div>
      <input type="range" id="minCostSlider" min="0" max="28" step="1" value="0"/>
    </div>
    <div class="cost-range-group">
      <div class="cost-range-label">Max Cost ≤ <span id="maxCostLabel">32</span></div>
      <input type="range" id="maxCostSlider" min="4" max="32" step="1" value="32"/>
    </div>
    <div style="display:flex;flex-direction:column;gap:5px;">
      <div class="ctrl-label">Quick Presets</div>
      <div class="cost-presets" id="costPresets">
        <button class="cost-preset-btn active" id="costResetBtn">All</button>
      </div>
    </div>
  </div>

  <div class="efficiency-panel" id="efficiencyPanel" style="display:none;">
    <div class="efficiency-panel-title">Cost Efficiency — results grouped into Cost Efficiency Tier brackets below (cost range auto-set to All, see above)</div>
    <div class="efficiency-target-group">
      <div class="cost-range-label" id="efficiencyTargetLabelWrap">Target <span id="efficiencyDirectionLabel">score ≤</span></div>
      <input type="number" step="0.01" id="efficiencyTargetInput"/>
    </div>
    <div class="direction-note" id="efficiencyDirectionNote"></div>
    <button class="reset-btn" id="resetEfficiencyBtn">Reset Target To Default</button>
  </div>

  <div class="settings-toggle" id="settingsToggle"><span class="chev">▶</span> Tier Settings — performance thresholds &amp; min appearance rate</div>
  <div class="settings-panel" id="settingsPanel">
    <div class="settings-col">
      <div class="ctrl-label">Score Metric (drives tiering)</div>
      <select id="metricSelect">
        <option value="Weighted_Avg_Score">Weighted Avg Score</option>
        <option value="Simple_Avg_Score">Simple Avg Score</option>
        <option value="Weighted_Avg_Median">Weighted Avg Median</option>
        <option value="Best_Version_Avg">Best Version Avg</option>
        <option value="Min_Score">Min Score (best in cycle modes)</option>
        <option value="Max_Score">Max Score (best in point modes)</option>
      </select>
      <div class="ctrl-label" style="margin-top:8px;">Min Simple Appearance Rate ≥ <span id="minAppLabel">{{ default_min_appearance }}</span>%</div>
      <input type="range" id="minAppSlider" min="0" max="3" step="0.01" value="{{ default_min_appearance }}"/>
      <button class="reset-btn" id="resetAllBtn">Reset All Modes To Defaults</button>
    </div>
    <div class="settings-col wide">
      <div class="ctrl-label" id="thresholdModeLabel">Thresholds — MOC</div>
      <div class="direction-note" id="directionNote">Lower score = better (cycles used)</div>
      <div class="threshold-row"><span class="tswatch" style="background:var(--t0)"></span><label>T0 <</label><input type="number" step="0.01" id="thresh_T0"/></div>
      <div class="threshold-row"><span class="tswatch" style="background:var(--t05)"></span><label>T0.5 <</label><input type="number" step="0.01" id="thresh_T0_5"/></div>
      <div class="threshold-row"><span class="tswatch" style="background:var(--t1)"></span><label>T1 <</label><input type="number" step="0.01" id="thresh_T1"/></div>
      <div class="threshold-row"><span class="tswatch" style="background:var(--t15)"></span><label>T1.5 <</label><input type="number" step="0.01" id="thresh_T1_5"/></div>
      <div class="threshold-row"><span class="tswatch" style="background:var(--t2)"></span><label>T2</label><span style="color:var(--text3)">everything else</span></div>
      <button class="reset-btn" id="resetModeBtn">Reset This Mode</button>
    </div>
    <div class="settings-col">
      <div class="ctrl-label">Cost Efficiency Tiers (Quick Presets above + ranking brackets in Cost Efficiency mode)</div>
      <div id="costTierEditor"></div>
      <button class="reset-btn" id="resetCostTiersBtn">Reset Cost Tiers To Defaults</button>
    </div>
  </div>

  <div class="results-info" id="resultsInfo">Loading…</div>

  <div class="tier-list" id="tierListContainer"></div>

</div>
<script>
const ICONS = {{ icons_json }};

// ---------------------------------------------------------------------
// TIER CONFIGURATION — edit these defaults directly in this template
// (by_cost_archetype_tier_list_template.html.j2) to change what counts
// as T0 / T0.5 / T1 / T1.5 / T2 for each game mode before regenerating,
// or tweak them live in the "Tier Settings" panel in the browser.
//
// direction:
//   'asc'  = lower score is better (Game_Modes scored in cycles, e.g. MOC/Anomaly)
//   'desc' = higher score is better (Game_Modes scored in points, e.g. APOC/Pure Fiction)
//
// thresholds are the UPPER bound (asc) or LOWER bound (desc) of each tier —
// i.e. for 'asc', a row lands in T0 if score < thresholds.T0, in T0.5 if
// score < thresholds.T0_5, etc, and T2 if it exceeds every threshold.
// ---------------------------------------------------------------------
const DEFAULT_TIER_CONFIG = {{ tier_config_json }};

const MODE_META = {{ mode_meta_json }};

// Manifest of rolling 3-version-window snapshots, one entry per
// As_Of_Version, oldest first. Each entry's `file` is a Brotli-compressed
// JSON dataset (same row shape as the main dataset) generated by
// by_cost_archetype_tier_list_generator.py alongside this page.
const HISTORY_MANIFEST = {{ history_manifest_json }};

let TIER_CONFIG = JSON.parse(JSON.stringify(DEFAULT_TIER_CONFIG));
const DEFAULT_MIN_APPEARANCE = {{ default_min_appearance }};

// ---------------------------------------------------------------------
// COST TIER PRESETS — the Quick Presets buttons in the Cost Range panel.
// Purely a UI convenience for setting costMinFilter/costMaxFilter; edit
// defaults in by_cost_archetype_tier_list_generator.py (DEFAULT_COST_TIERS)
// or live in-browser via the Cost Tier Presets editor in Tier Settings.
// ---------------------------------------------------------------------
const DEFAULT_COST_TIERS = {{ cost_tiers_json }};
let COST_TIERS = JSON.parse(JSON.stringify(DEFAULT_COST_TIERS));

// Color palette cycled across however many Cost Efficiency Tiers exist
// (COST_TIERS is editable/reorderable via the Tier Settings panel, so the
// count isn't fixed at 5). 'Unranked' (cost outside every configured
// bracket) always gets --muted.
const COST_TIER_PALETTE = ['var(--accent)','var(--teal)','var(--purple)','var(--gold)','var(--orange)','var(--green)','var(--red)'];

// Assigns a row to the FIRST Cost Efficiency Tier (in COST_TIERS order)
// whose [min,max] contains its estimated_min_cost. Tiers are allowed to
// overlap (e.g. Budget 0–8 contains F2P's 0–4) -- first match wins, so
// ordering the tiers cheapest-first in the editor gives the expected
// "most specific bracket" grouping. Returns -1 if no configured tier
// covers that cost (shown as an "Unranked" bucket).
function assignCostTierIndex(cost) {
  for (let i = 0; i < COST_TIERS.length; i++) {
    if (cost >= COST_TIERS[i].min && cost <= COST_TIERS[i].max) return i;
  }
  return -1;
}

// ---------------------------------------------------------------------
// COST EFFICIENCY — per-mode "reach at least this score" target used by
// the Cost Efficiency ranking mode. Defaults mirror each mode's T1
// threshold (see generator's DEFAULT_EFFICIENCY_TARGET); fully editable
// live via the efficiency panel's Target input.
// ---------------------------------------------------------------------
const DEFAULT_EFFICIENCY_TARGET = {{ efficiency_target_json }};
let efficiencyTarget = JSON.parse(JSON.stringify(DEFAULT_EFFICIENCY_TARGET));
let rankingMode = 'tier'; // 'tier' | 'efficiency'
// Cost range remembered from Tier List mode, restored when leaving efficiency mode.
let _savedCostMin = null, _savedCostMax = null;

let RAW_DATA = [];
let LATEST_DATA = null;           // the initially-loaded "Latest" dataset, cached for instant switch-back
const HISTORY_CACHE = new Map();  // version string -> parsed row array, filled in lazily on first visit
let currentVersionKey = '__latest__';
let _firstDataLoad = true;
let TOKEN_INDEX = new Map();
let MIN_COST_G = 0, MAX_COST_G = 32;

let currentMode   = null;
let currentCategory = 'archetype'; // 'archetype' | 'sustain' | 'amplifier'
const CATEGORY_META = {
  archetype: { label: 'Archetypes', noun: 'archetypes' },
  sustain:   { label: 'Sustains',   noun: 'sustain characters' },
  amplifier: { label: 'Amplifiers', noun: 'amplifier characters' },
};
let activeMeids   = new Set([0,1,2,3,4,5,6]);
let sustainYes    = true;
let sustainNo     = true;
let searchTerm    = '';
let costMinFilter = 0;
let costMaxFilter = 32;
let scoreMetric   = 'Weighted_Avg_Score';
let minAppearance = DEFAULT_MIN_APPEARANCE;

const TIER_ORDER = ['T0','T0.5','T1','T1.5','T2'];

function parseMembers(core) {
  return core.split(/\s*[,\/\+]\s*/).map(s => s.trim()).filter(Boolean);
}

function iconEl(name) {
  let url = ICONS[name] || ICONS[name.replace(/\s+LV\.\d+$/,'').trim()];
  if (url) {
    if (!url.startsWith('http')) url = "{{ path_prefix }}" + url;
    return `<img class="char-icon" src="${url}" alt="${name}" title="${name}" onerror="this.style.display='none'"/>`;
  }
  return `<div class="char-icon-placeholder" title="${name}">${name.slice(0,2).toUpperCase()}</div>`;
}

function searchIndex(query) {
  const eidMatch = query.match(/^(.+?)\s*\(?(e\d)\)?$/i);
  const words = query.split(/\s+/).filter(Boolean);
  if (!words.length) return null;
  let resultSet = null;
  for (const word of words) {
    const hits = new Set();
    TOKEN_INDEX.forEach((indices, tok) => { if (tok.includes(word)) indices.forEach(i => hits.add(i)); });
    resultSet = resultSet === null ? hits : new Set([...resultSet].filter(i => hits.has(i)));
    if (!resultSet.size) break;
  }
  if (eidMatch && resultSet) {
    const base = eidMatch[1].trim().toLowerCase();
    const eidTag = eidMatch[2].toLowerCase();
    resultSet = new Set([...resultSet].filter(i =>
      RAW_DATA[i]._members.some(m => {
        const ml = m.toLowerCase();
        return ml.replace(/\s*\(e\d\)/gi,'').trim() === base && ml.includes('(' + eidTag + ')');
      })
    ));
  }
  return resultSet;
}

function assignTier(score, cfg) {
  if (score == null || isNaN(score)) return null;
  const boundaryKeys = ['T0','T0_5','T1','T1_5'];
  if (cfg.direction === 'asc') {
    for (const k of boundaryKeys) if (score < cfg.thresholds[k]) return k.replace('_','.');
    return 'T2';
  } else {
    for (const k of boundaryKeys) if (score > cfg.thresholds[k]) return k.replace('_','.');
    return 'T2';
  }
}

function fmtPct(v) { return v == null ? '—' : v.toFixed(2) + '%'; }
function fmtNum(v, d=2) { return v == null ? '—' : v.toFixed(d); }
function fmtInt(v) { return v == null ? '—' : Math.round(v).toLocaleString(); }

function buildModeTabs() {
  const wrap = document.getElementById('modeTabs');
  wrap.innerHTML = '';
  Object.keys(MODE_META).forEach(mode => {
    const present = RAW_DATA.some(r => r.Game_Mode === mode && r.Category === currentCategory);
    if (!present) return;
    const btn = document.createElement('button');
    btn.className = 'mode-tab' + (mode === currentMode ? ' active' : '');
    btn.textContent = MODE_META[mode].label;
    btn.dataset.mode = mode;
    btn.addEventListener('click', () => {
      currentMode = mode;
      document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      syncThresholdInputs();
      syncEfficiencyInputs();
      recompute();
    });
    wrap.appendChild(btn);
  });
}

document.querySelectorAll('.category-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    if (btn.dataset.category === currentCategory) return;
    currentCategory = btn.dataset.category;
    document.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');

    const modesPresent = Object.keys(MODE_META).filter(m => RAW_DATA.some(r => r.Game_Mode === m && r.Category === currentCategory));
    if (!currentMode || !modesPresent.includes(currentMode)) {
      currentMode = modesPresent[0] || null;
    }
    buildModeTabs();
    syncThresholdInputs();
    syncEfficiencyInputs();
    recompute();
  });
});

function syncThresholdInputs() {
  if (!currentMode) return;
  const cfg = TIER_CONFIG[currentMode];
  document.getElementById('thresholdModeLabel').textContent = 'Thresholds — ' + (MODE_META[currentMode]?.label || currentMode);
  document.getElementById('directionNote').textContent = cfg.direction === 'asc'
    ? 'Lower score = better (cycles used)'
    : 'Higher score = better (points)';
  document.getElementById('thresh_T0').value   = cfg.thresholds.T0;
  document.getElementById('thresh_T0_5').value = cfg.thresholds.T0_5;
  document.getElementById('thresh_T1').value   = cfg.thresholds.T1;
  document.getElementById('thresh_T1_5').value = cfg.thresholds.T1_5;
}

// Keeps the Cost Efficiency panel's Target input/label/direction note in
// sync with the currently-selected mode. Called whenever currentMode
// changes (mode tab, category tab, or a dataset/version switch).
function syncEfficiencyInputs() {
  if (!currentMode) return;
  const cfg = TIER_CONFIG[currentMode];
  const cmp = cfg.direction === 'asc' ? 'score ≤' : 'score ≥';
  document.getElementById('efficiencyDirectionLabel').textContent = cmp;
  document.getElementById('efficiencyTargetInput').value = efficiencyTarget[currentMode];
  document.getElementById('efficiencyDirectionNote').textContent = cfg.direction === 'asc'
    ? 'Lower score = better (cycles used) — cheapest way to stay at or under this score'
    : 'Higher score = better (points) — cheapest way to reach at least this score';
}

document.getElementById('efficiencyTargetInput').addEventListener('input', e => {
  if (!currentMode) return;
  const v = parseFloat(e.target.value);
  if (!isNaN(v)) { efficiencyTarget[currentMode] = v; recompute(); }
});
document.getElementById('resetEfficiencyBtn').addEventListener('click', () => {
  if (!currentMode) return;
  efficiencyTarget[currentMode] = DEFAULT_EFFICIENCY_TARGET[currentMode];
  syncEfficiencyInputs();
  recompute();
});

// Locks the Cost Range panel to the dataset's full bounds while Cost
// Efficiency mode is active -- efficiency ranking is meant to search the
// whole cost range for the cheapest option, not a pre-narrowed slice.
function lockCostPanelToAll() {
  _savedCostMin = costMinFilter; _savedCostMax = costMaxFilter;
  clearPresets();
  document.getElementById('costResetBtn').classList.add('active');
  applyPreset(MIN_COST_G, MAX_COST_G);
  document.getElementById('costPanel').classList.add('locked');
  document.getElementById('costPanelLockNote').style.display = 'block';
}
function unlockCostPanel() {
  document.getElementById('costPanel').classList.remove('locked');
  document.getElementById('costPanelLockNote').style.display = 'none';
  if (_savedCostMin != null && _savedCostMax != null) {
    clearPresets();
    document.getElementById('costResetBtn').classList.remove('active');
    applyPreset(_savedCostMin, _savedCostMax);
  }
}

document.querySelectorAll('.ranking-mode-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    const mode = btn.dataset.rankingMode;
    if (mode === rankingMode) return;
    rankingMode = mode;
    document.querySelectorAll('.ranking-mode-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    const effPanel = document.getElementById('efficiencyPanel');
    if (rankingMode === 'efficiency') {
      effPanel.style.display = 'flex';
      syncEfficiencyInputs();
      lockCostPanelToAll();
    } else {
      effPanel.style.display = 'none';
      unlockCostPanel();
    }
    recompute();
  });
});

['thresh_T0','thresh_T0_5','thresh_T1','thresh_T1_5'].forEach(id => {
  document.getElementById(id).addEventListener('input', e => {
    if (!currentMode) return;
    const key = id.replace('thresh_','');
    const v = parseFloat(e.target.value);
    if (!isNaN(v)) { TIER_CONFIG[currentMode].thresholds[key] = v; recompute(); }
  });
});

document.getElementById('resetModeBtn').addEventListener('click', () => {
  if (!currentMode) return;
  TIER_CONFIG[currentMode] = JSON.parse(JSON.stringify(DEFAULT_TIER_CONFIG[currentMode]));
  syncThresholdInputs();
  recompute();
});
document.getElementById('resetAllBtn').addEventListener('click', () => {
  TIER_CONFIG = JSON.parse(JSON.stringify(DEFAULT_TIER_CONFIG));
  efficiencyTarget = JSON.parse(JSON.stringify(DEFAULT_EFFICIENCY_TARGET));
  COST_TIERS = JSON.parse(JSON.stringify(DEFAULT_COST_TIERS));
  minAppearance = DEFAULT_MIN_APPEARANCE;
  document.getElementById('minAppSlider').value = DEFAULT_MIN_APPEARANCE;
  document.getElementById('minAppLabel').textContent = DEFAULT_MIN_APPEARANCE;
  syncThresholdInputs();
  syncEfficiencyInputs();
  renderCostTierEditor();
  renderCostPresets();
  recompute();
});

document.getElementById('settingsToggle').addEventListener('click', () => {
  document.getElementById('settingsPanel').classList.toggle('open');
  document.getElementById('settingsToggle').classList.toggle('open');
});

document.getElementById('metricSelect').addEventListener('change', e => {
  scoreMetric = e.target.value;
  recompute();
});
document.getElementById('minAppSlider').addEventListener('input', e => {
  minAppearance = parseFloat(e.target.value);
  document.getElementById('minAppLabel').textContent = minAppearance;
  recompute();
});

document.querySelectorAll('#meidFilters .btn-toggle').forEach(btn => {
  btn.addEventListener('click', () => {
    const e = parseFloat(btn.dataset.meid);
    if (activeMeids.has(e)) { if (activeMeids.size > 1) { activeMeids.delete(e); btn.classList.remove('active'); } }
    else { activeMeids.add(e); btn.classList.add('active'); }
    recompute();
  });
});

document.getElementById('sustainYesBtn').addEventListener('click', function() {
  if (sustainYes && !sustainNo) return; // don't allow zero-state
  sustainYes = !sustainYes;
  this.classList.toggle('active', sustainYes);
  recompute();
});
document.getElementById('sustainNoBtn').addEventListener('click', function() {
  if (sustainNo && !sustainYes) return;
  sustainNo = !sustainNo;
  this.classList.toggle('active', sustainNo);
  recompute();
});

function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }
document.getElementById('searchInput').addEventListener('input', debounce(e => {
  searchTerm = e.target.value.trim().toLowerCase();
  recompute();
}, 200));

function sliderFill(s) {
  const pct = ((parseFloat(s.value) - parseFloat(s.min)) / (parseFloat(s.max) - parseFloat(s.min)) * 100).toFixed(1);
  s.style.setProperty('--fill', pct + '%');
}
const minSlider = document.getElementById('minCostSlider');
const maxSlider = document.getElementById('maxCostSlider');
minSlider.addEventListener('input', () => {
  if (parseFloat(minSlider.value) >= parseFloat(maxSlider.value) - 4) minSlider.value = parseFloat(maxSlider.value) - 4;
  costMinFilter = parseFloat(minSlider.value);
  document.getElementById('minCostLabel').textContent = costMinFilter;
  sliderFill(minSlider); clearPresets(); recompute();
});
maxSlider.addEventListener('input', () => {
  if (parseFloat(maxSlider.value) <= parseFloat(minSlider.value) + 4) maxSlider.value = parseFloat(minSlider.value) + 4;
  costMaxFilter = parseFloat(maxSlider.value);
  document.getElementById('maxCostLabel').textContent = costMaxFilter;
  sliderFill(maxSlider); clearPresets(); recompute();
});
function clearPresets() { document.querySelectorAll('.cost-preset-btn').forEach(b => b.classList.remove('active')); }
function applyPreset(mn, mx) {
  costMinFilter = mn; costMaxFilter = mx;
  minSlider.value = mn; maxSlider.value = mx;
  document.getElementById('minCostLabel').textContent = mn;
  document.getElementById('maxCostLabel').textContent = mx;
  sliderFill(minSlider); sliderFill(maxSlider); recompute();
}

// Rebuilds the Quick Presets buttons from COST_TIERS (adjustable via the
// Cost Tier Presets editor in Tier Settings) plus the static "All" button.
function renderCostPresets() {
  const wrap = document.getElementById('costPresets');
  wrap.querySelectorAll('.cost-preset-btn[data-min]').forEach(b => b.remove());
  const allBtn = document.getElementById('costResetBtn');
  COST_TIERS.forEach(tier => {
    const btn = document.createElement('button');
    btn.className = 'cost-preset-btn';
    btn.dataset.min = tier.min; btn.dataset.max = tier.max;
    btn.textContent = `${tier.label} (${tier.min}\u2013${tier.max})`;
    btn.addEventListener('click', () => { clearPresets(); btn.classList.add('active'); applyPreset(tier.min, tier.max); });
    wrap.insertBefore(btn, allBtn);
  });
}
document.getElementById('costResetBtn').addEventListener('click', () => {
  clearPresets();
  document.getElementById('costResetBtn').classList.add('active');
  applyPreset(MIN_COST_G, MAX_COST_G);
});

// Builds the editable Cost Tier Presets rows inside Tier Settings, one
// per entry in COST_TIERS -- editing min/max here reruns renderCostPresets()
// so the Quick Presets buttons pick up the new values immediately.
function renderCostTierEditor() {
  const wrap = document.getElementById('costTierEditor');
  wrap.innerHTML = '';
  COST_TIERS.forEach((tier, i) => {
    const row = document.createElement('div');
    row.className = 'cost-tier-row';
    row.innerHTML = `<label title="${tier.label}">${tier.label}</label>
      <input type="number" step="1" value="${tier.min}" data-i="${i}" data-field="min"/>
      <span class="dash">\u2013</span>
      <input type="number" step="1" value="${tier.max}" data-i="${i}" data-field="max"/>`;
    wrap.appendChild(row);
  });
  wrap.querySelectorAll('input[type="number"]').forEach(inp => {
    inp.addEventListener('input', e => {
      const i = +e.target.dataset.i, field = e.target.dataset.field;
      const v = parseFloat(e.target.value);
      if (!isNaN(v)) { COST_TIERS[i][field] = v; renderCostPresets(); recompute(); }
    });
  });
}
document.getElementById('resetCostTiersBtn').addEventListener('click', () => {
  COST_TIERS = JSON.parse(JSON.stringify(DEFAULT_COST_TIERS));
  renderCostTierEditor();
  renderCostPresets();
  recompute();
});
renderCostPresets();
renderCostTierEditor();

function recompute() {
  if (!currentMode) return;
  let candidate = RAW_DATA.filter(r => r.Game_Mode === currentMode && r.Category === currentCategory);

  candidate = candidate.filter(r => {
    if (!activeMeids.has(Math.round(r.max_eidolon))) return false;
    if (r.estimated_min_cost < costMinFilter || r.estimated_max_cost > costMaxFilter) return false;
    const hasSustain = r.Sustain_Rate_pct >= 50;
    if (hasSustain && !sustainYes) return false;
    if (!hasSustain && !sustainNo) return false;
    return true;
  });

  const cfg = TIER_CONFIG[currentMode];

  if (rankingMode === 'efficiency') {
    const target = efficiencyTarget[currentMode];
    let qualifying = [];
    let hidden = 0;
    candidate.forEach(r => {
      if ((r.Simple_Avg_Appearance || 0) < minAppearance) { hidden++; return; }
      const score = r[scoreMetric];
      if (score == null || isNaN(score)) return;
      const meets = cfg.direction === 'asc' ? score <= target : score >= target;
      if (meets) qualifying.push(r);
    });
    // Cheapest min-cost first; ties broken by best score at that cost.
    qualifying.sort((a, b) => {
      if (a.estimated_min_cost !== b.estimated_min_cost) return a.estimated_min_cost - b.estimated_min_cost;
      const av = a[scoreMetric], bv = b[scoreMetric];
      return cfg.direction === 'asc' ? av - bv : bv - av;
    });
    // Assign one continuous #1..#N rank across the FULL qualifying set --
    // spanning every Cost Efficiency Tier bracket -- BEFORE search narrows
    // anything. Search is a find-in-list tool here, not a re-ranking
    // filter, so a row's number stays fixed no matter what's typed.
    qualifying.forEach((r, i) => { r._effRank = i + 1; });

    const displayed = applySearchFilter(qualifying);
    renderEfficiencyList(displayed, cfg, target);
    updateEfficiencyMeta(displayed, hidden, target, cfg, qualifying.length);
    return;
  }

  candidate = applySearchFilter(candidate);

  const ranked = [];
  let hidden = 0;
  candidate.forEach(r => {
    if ((r.Simple_Avg_Appearance || 0) < minAppearance) { hidden++; return; }
    const tier = assignTier(r[scoreMetric], cfg);
    if (tier) ranked.push({ ...r, _tier: tier });
  });

  ranked.sort((a, b) => {
    const av = a[scoreMetric], bv = b[scoreMetric];
    return cfg.direction === 'asc' ? av - bv : bv - av;
  });

  renderTierList(ranked, cfg);
  updateMeta(ranked, hidden);
}

// Shared search-narrowing step used by both ranking modes. Kept separate
// from the rest of recompute()'s filtering so Cost Efficiency mode can
// run it AFTER ranks are assigned (see note above).
function applySearchFilter(rows) {
  if (searchTerm.length >= 2) {
    const hits = searchIndex(searchTerm);
    return hits ? rows.filter(r => hits.has(r._idx)) : [];
  } else if (searchTerm.length === 1) {
    return rows.filter(r => r._coreLower.includes(searchTerm));
  }
  return rows;
}

function updateMeta(ranked, hidden) {
  document.getElementById('visibleCount').textContent = ranked.length.toLocaleString();
  document.getElementById('hiddenCount').textContent  = hidden.toLocaleString();
  document.getElementById('costRangeDisplay').textContent = costMinFilter + '–' + costMaxFilter;
  document.getElementById('resultsInfo').innerHTML =
    `Showing <span>${ranked.length}</span> ranked ${CATEGORY_META[currentCategory].noun} for <span>${MODE_META[currentMode]?.label || currentMode}</span> · ` +
    `metric <span>${scoreMetric}</span> · min appearance <span>${minAppearance}%</span> · ` +
    `<span>${hidden}</span> hidden below threshold`;
}

function updateEfficiencyMeta(displayed, hidden, target, cfg, totalQualifying) {
  document.getElementById('visibleCount').textContent = totalQualifying.toLocaleString();
  document.getElementById('hiddenCount').textContent  = hidden.toLocaleString();
  document.getElementById('costRangeDisplay').textContent = 'All';
  const cmp = cfg.direction === 'asc' ? '≤' : '≥';
  const searchNote = displayed.length !== totalQualifying ? ` · <span>${displayed.length}</span> shown for search` : '';
  document.getElementById('resultsInfo').innerHTML =
    `<span>${totalQualifying}</span> ${CATEGORY_META[currentCategory].noun} reach score ${cmp} <span>${target}</span> for <span>${MODE_META[currentMode]?.label || currentMode}</span>${searchNote} · ` +
    `metric <span>${scoreMetric}</span> · ranks are continuous across cost brackets · min appearance <span>${minAppearance}%</span> · ` +
    `<span>${hidden}</span> hidden below threshold`;
}

function efficiencyRowHTML(r, rank, scoreMetric) {
  const eid = Math.round(r.max_eidolon);
  const sustainCls = r.Sustain_Rate_pct >= 50 ? 'sustain-hi' : 'sustain-lo';
  return `<div class="efficiency-row">
    <div class="efficiency-rank">#${rank}</div>
    <div class="arch-card-icons">${r._iconsHtml}</div>
    <div class="arch-card-name" title="${r.Archetype_Core}">${r.Archetype_Core}</div>
    <div class="arch-card-stats">
      <span class="stat-pill cost-hero">${r.estimated_min_cost}→${r.estimated_max_cost}</span>
      <span class="stat-pill score">${fmtNum(r[scoreMetric], 2)}</span>
      <span class="stat-pill rate">${fmtPct(r.Simple_Avg_Appearance)} app.</span>
      <span class="stat-pill eid">E${eid}</span>
      <span class="stat-pill ${sustainCls}">${fmtPct(r.Sustain_Rate_pct)} sus.</span>
      <span class="stat-pill full-star">${fmtPct(r.Full_Star_Rate_pct)} 3★</span>
      <span class="stat-pill">n=${fmtInt(r.Total_Samples)}</span>
    </div>
  </div>`;
}

function renderEfficiencyList(qualifying, cfg, target) {
  const container = document.getElementById('tierListContainer');
  container.innerHTML = '';
  if (!qualifying.length) {
    const cmp = cfg.direction === 'asc' ? '≤' : '≥';
    container.innerHTML = `<div class="empty-state"><div class="icon">💰</div><p>No ${CATEGORY_META[currentCategory].noun} reach score ${cmp} ${target} under current filters</p></div>`;
    return;
  }

  // Group into Cost Efficiency Tier brackets (COST_TIERS -- the same rows
  // edited in the Tier Settings "Cost Efficiency Tiers" editor and shown
  // as Quick Presets buttons above). `qualifying` is already sorted
  // cheapest-min-cost-first by the caller, so each bucket comes out
  // pre-sorted too.
  const buckets = COST_TIERS.map(() => []);
  const unranked = [];
  qualifying.forEach(r => {
    const idx = assignCostTierIndex(r.estimated_min_cost);
    (idx === -1 ? unranked : buckets[idx]).push(r);
  });

  const list = document.createElement('div');
  list.className = 'efficiency-tier-list';
  COST_TIERS.forEach((tier, idx) => {
    list.appendChild(costTierRow(tier.label, tier.min, tier.max, buckets[idx], COST_TIER_PALETTE[idx % COST_TIER_PALETTE.length]));
  });
  if (unranked.length) {
    list.appendChild(costTierRow('Unranked', null, null, unranked, 'var(--muted)'));
  }
  container.appendChild(list);
}

function costTierRow(label, min, max, items, color) {
  const row = document.createElement('div');
  row.className = 'efficiency-tier-row';

  const labelWrap = document.createElement('div');
  labelWrap.className = 'efficiency-tier-label-wrap';
  labelWrap.style.background = color;
  const rangeText = (min == null || max == null) ? 'out of range' : `${min}–${max}`;
  labelWrap.innerHTML = `<div class="efficiency-tier-label">${label}</div><div class="efficiency-tier-range">${rangeText}</div><div class="efficiency-tier-count">${items.length}</div>`;
  row.appendChild(labelWrap);

  const content = document.createElement('div');
  content.className = 'efficiency-tier-content';
  content.innerHTML = items.map(r => efficiencyRowHTML(r, r._effRank, scoreMetric)).join('');
  row.appendChild(content);

  return row;
}

function cardHTML(r) {
  const eid = Math.round(r.max_eidolon);
  const sustainCls = r.Sustain_Rate_pct >= 50 ? 'sustain-hi' : 'sustain-lo';
  return `<div class="arch-card">
    <div class="arch-card-icons">${r._iconsHtml}</div>
    <div class="arch-card-name" title="${r.Archetype_Core}">${r.Archetype_Core}</div>
    <div class="arch-card-stats">
      <span class="stat-pill score">${fmtNum(r[scoreMetric], 2)}</span>
      <span class="stat-pill rate">${fmtPct(r.Simple_Avg_Appearance)} app.</span>
      <span class="stat-pill cost">${r.estimated_min_cost}→${r.estimated_max_cost}</span>
      <span class="stat-pill eid">E${eid}</span>
      <span class="stat-pill ${sustainCls}">${fmtPct(r.Sustain_Rate_pct)} sus.</span>
      <span class="stat-pill full-star">${fmtPct(r.Full_Star_Rate_pct)} 3★</span>
      <span class="stat-pill">n=${fmtInt(r.Total_Samples)}</span>
    </div>
  </div>`;
}

function renderTierList(ranked, cfg) {
  const container = document.getElementById('tierListContainer');
  container.innerHTML = '';

  if (!ranked.length) {
    container.innerHTML = `<div class="empty-state"><div class="icon">⚡</div><p>No ${CATEGORY_META[currentCategory].noun} match current filters for this mode</p></div>`;
    return;
  }

  const byTier = {};
  TIER_ORDER.forEach(t => byTier[t] = []);
  ranked.forEach(r => byTier[r._tier].push(r));

  TIER_ORDER.forEach(tier => {
    const items = byTier[tier];
    const tierClass = tier.replace('.', '\\.');
    const row = document.createElement('div');
    row.className = `tier-row tier-${tierClass}`;

    const labelWrap = document.createElement('div');
    labelWrap.className = 'tier-label-wrap';
    labelWrap.innerHTML = `<div class="tier-label">${tier}</div><div class="tier-count">${items.length}</div>`;
    row.appendChild(labelWrap);

    const content = document.createElement('div');
    content.className = 'tier-content';
    content.innerHTML = items.map(cardHTML).join('');
    row.appendChild(content);

    container.appendChild(row);
  });
}

function prepareData() {
  RAW_DATA.forEach((r, i) => {
    r._idx = i;
    const members = parseMembers(r.Archetype_Core);
    r._members = members;
    r._coreLower = r.Archetype_Core.toLowerCase();
    r._iconsHtml = members.map(m => iconEl(m.replace(/\s*\(E\d\)/gi,'').trim())).join('');
  });

  MIN_COST_G = Math.min(...RAW_DATA.map(r => r.estimated_min_cost));
  MAX_COST_G = Math.max(...RAW_DATA.map(r => r.estimated_max_cost));
  minSlider.min = MIN_COST_G; minSlider.max = MAX_COST_G - 4;
  maxSlider.min = MIN_COST_G + 4; maxSlider.max = MAX_COST_G;

  if (_firstDataLoad) {
    // First page load: snap the cost range to this dataset's full bounds.
    costMinFilter = MIN_COST_G; costMaxFilter = MAX_COST_G;
    _firstDataLoad = false;
  } else {
    // Switching between Latest/History snapshots: keep the person's chosen
    // cost range, just clamp it into whatever bounds this snapshot has.
    costMinFilter = Math.min(Math.max(costMinFilter, MIN_COST_G), MAX_COST_G - 4);
    costMaxFilter = Math.max(Math.min(costMaxFilter, MAX_COST_G), MIN_COST_G + 4);
  }
  minSlider.value = costMinFilter; maxSlider.value = costMaxFilter;
  document.getElementById('minCostLabel').textContent = costMinFilter;
  document.getElementById('maxCostLabel').textContent = costMaxFilter;
  sliderFill(minSlider); sliderFill(maxSlider);

  TOKEN_INDEX = new Map();
  RAW_DATA.forEach((r, i) => {
    const tokens = r._coreLower.split(/[\s\(\),\/\+•&]+/).filter(t => t.length >= 2);
    new Set(tokens).forEach(tok => {
      if (!TOKEN_INDEX.has(tok)) TOKEN_INDEX.set(tok, []);
      TOKEN_INDEX.get(tok).push(i);
    });
  });

  // Keep the person's current mode selection if this snapshot still has
  // data for it (within the currently-selected category); otherwise fall
  // back to the first available mode.
  const modesPresent = Object.keys(MODE_META).filter(m => RAW_DATA.some(r => r.Game_Mode === m && r.Category === currentCategory));
  if (!currentMode || !modesPresent.includes(currentMode)) {
    currentMode = modesPresent[0] || null;
  }
  buildModeTabs();
  syncThresholdInputs();
  syncEfficiencyInputs();
}

let _brotliPromise = null;
function getBrotli() {
  if (!_brotliPromise) _brotliPromise = import("../vendor/brotli-wasm/index.web.js").then(m => m.default);
  return _brotliPromise;
}

async function fetchAndDecompress(filename) {
  const response = await fetch(filename);
  if (!response.ok) throw new Error('Failed to fetch data: ' + filename);
  const buffer = await response.arrayBuffer();
  const brotli = await getBrotli();
  const decompressed = brotli.decompress(new Uint8Array(buffer));
  return JSON.parse(new TextDecoder().decode(decompressed));
}

async function loadDataset(filename) {
  RAW_DATA = await fetchAndDecompress(filename);
  LATEST_DATA = RAW_DATA;
  prepareData();
  recompute();
}

async function initializeApp() {
  try {
    await loadDataset("{{ data_filename }}");
    buildVersionSelect();
  } catch (err) {
    console.error('Data load error:', err);
    document.getElementById('resultsInfo').textContent = '⚠️ Failed to load data. Check console.';
    document.getElementById('tierListContainer').innerHTML =
      `<div class="empty-state"><div class="icon">⚠️</div><p>Failed to load data. Please refresh or check the network.</p></div>`;
  }
}

// ---------------------------------------------------------------------
// PAST RANKINGS -- version history navigation
//
// HISTORY_MANIFEST holds one entry per Version_Group_Num snapshot (1 =
// newest, ascending from there). Version_Group_Num is ranked PER GAME
// MODE, so group_num N pulls each mode's own Nth-most-recent rolling
// window together -- this is what keeps every mode's tab present at a
// given snapshot instead of silently dropping modes whose calendar
// version string didn't match. The newest entry (group_num 1) is flagged
// is_latest=true because it's the same dataset as the default page load,
// so it's excluded from the dropdown/arrow order and mapped straight back
// to '__latest__' instead of being re-fetched.
// ---------------------------------------------------------------------
const HISTORY_ENTRIES = HISTORY_MANIFEST.filter(e => !e.is_latest); // ascending group_num, i.e. newest-of-the-rest first
const VERSION_ORDER = ['__latest__', ...HISTORY_ENTRIES.map(e => e.group_num)];

function findHistoryEntry(groupNum) {
  return HISTORY_ENTRIES.find(e => e.group_num === groupNum) || null;
}

function modeVersionSummary(entry) {
  if (!entry) return '';
  return Object.entries(entry.mode_versions)
    .map(([mode, ver]) => (MODE_META[mode]?.label || mode) + ' ' + ver)
    .join(' · ');
}

function buildVersionSelect() {
  const panel = document.getElementById('versionPanel');
  if (!HISTORY_ENTRIES.length) { panel.style.display = 'none'; return; }

  const sel = document.getElementById('versionSelect');
  sel.innerHTML = '';
  const latestEntry = HISTORY_MANIFEST.find(e => e.is_latest);
  const latestOpt = document.createElement('option');
  latestOpt.value = '__latest__';
  latestOpt.textContent = 'Latest' + (latestEntry ? (' — ' + modeVersionSummary(latestEntry)) : '') + ' (live)';
  sel.appendChild(latestOpt);

  HISTORY_ENTRIES.forEach(entry => {
    const opt = document.createElement('option');
    opt.value = String(entry.group_num);
    opt.textContent = 'Snapshot #' + entry.group_num + ' · ' + entry.row_count.toLocaleString() + ' rows';
    sel.appendChild(opt);
  });

  sel.value = currentVersionKey === '__latest__' ? '__latest__' : String(currentVersionKey);
  sel.addEventListener('change', () => {
    switchToVersion(sel.value === '__latest__' ? '__latest__' : parseInt(sel.value, 10));
  });
  document.getElementById('verPrevBtn').addEventListener('click', () => stepVersion(1));
  document.getElementById('verNextBtn').addEventListener('click', () => stepVersion(-1));

  updateVersionNav();
}

function stepVersion(direction) {
  // direction +1 = older (Prev button), -1 = newer (Next button)
  const idx = VERSION_ORDER.indexOf(currentVersionKey);
  const nextIdx = idx + direction;
  if (nextIdx < 0 || nextIdx >= VERSION_ORDER.length) return;
  switchToVersion(VERSION_ORDER[nextIdx]);
}

async function switchToVersion(versionKey) {
  if (versionKey === currentVersionKey) return;
  const loadingTag = document.getElementById('versionLoadingTag');

  try {
    if (versionKey === '__latest__') {
      RAW_DATA = LATEST_DATA;
    } else if (HISTORY_CACHE.has(versionKey)) {
      RAW_DATA = HISTORY_CACHE.get(versionKey);
    } else {
      const entry = findHistoryEntry(versionKey);
      if (!entry) return;
      loadingTag.classList.add('active');
      const data = await fetchAndDecompress(entry.file); // e.g. "history/by_cost_archetype_history_g5.json.br", relative to this page
      HISTORY_CACHE.set(versionKey, data);
      RAW_DATA = data;
    }
    currentVersionKey = versionKey;
    prepareData();
    recompute();
    updateVersionNav();
  } catch (err) {
    console.error('History snapshot load error:', err);
    document.getElementById('resultsInfo').textContent = '⚠️ Failed to load that snapshot. Check console.';
  } finally {
    loadingTag.classList.remove('active');
  }
}

function updateVersionNav() {
  const sel = document.getElementById('versionSelect');
  if (sel) sel.value = currentVersionKey === '__latest__' ? '__latest__' : String(currentVersionKey);

  const idx = VERSION_ORDER.indexOf(currentVersionKey);
  document.getElementById('verPrevBtn').disabled = (idx >= VERSION_ORDER.length - 1);
  document.getElementById('verNextBtn').disabled = (idx <= 0);

  const note = document.getElementById('versionWindowNote');
  if (currentVersionKey === '__latest__') {
    note.innerHTML = '<span class="live-tag">● LIVE</span> — ' + modeVersionSummary(HISTORY_MANIFEST.find(e => e.is_latest));
  } else {
    const entry = findHistoryEntry(currentVersionKey);
    note.textContent = entry ? modeVersionSummary(entry) : ('Snapshot #' + currentVersionKey);
  }
}

// ---- Particle background ----
(function setupParticles() {
  const canvas = document.getElementById('particleCanvas');
  if (!canvas || !canvas.getContext) return;
  const ctx = canvas.getContext('2d');
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const PALETTE = ['56,189,248','45,212,191','167,139,250','251,191,36'];
  const LINK = 105;
  let w, h, dpr, motes = [], raf, running = false, t = 0;
  function mkMote(fb) {
    return { x:Math.random()*w, y:fb?h+8:Math.random()*h, vx:(Math.random()-.5)*.18, vy:-(Math.random()*.22+.06),
      r:Math.random()*1.5+.55, tp:Math.random()*Math.PI*2, ts:Math.random()*.016+.005,
      sw:Math.random()*.4+.12, sp:Math.random()*Math.PI*2, c:PALETTE[Math.floor(Math.random()*PALETTE.length)] };
  }
  function resize() {
    dpr=Math.min(devicePixelRatio||1,2); w=innerWidth; h=innerHeight;
    canvas.width=w*dpr; canvas.height=h*dpr;
    canvas.style.cssText=`position:fixed;inset:0;width:${w}px;height:${h}px;`;
    ctx.setTransform(dpr,0,0,dpr,0,0);
    motes=Array.from({length:Math.max(22,Math.min(55,Math.floor(w*h/34000)))},()=>mkMote(false));
  }
  function paint() {
    t++; ctx.clearRect(0,0,w,h);
    for(let i=0;i<motes.length;i++){
      const a=motes[i]; a.x+=a.vx; a.y+=a.vy; a.x+=Math.sin(t*.01+a.sp)*a.sw*.05;
      if(a.y<-10) Object.assign(a,mkMote(true));
      for(let j=i+1;j<motes.length;j++){
        const b=motes[j],dx=a.x-b.x,dy=a.y-b.y,d=Math.hypot(dx,dy);
        if(d<LINK){ctx.strokeStyle=`rgba(${a.c},${(1-d/LINK)*.09})`;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();}
      }
    }
    motes.forEach(m=>{
      const al=Math.max(.06,.28+Math.sin(t*m.ts+m.tp)*.22);
      const gr=ctx.createRadialGradient(m.x,m.y,0,m.x,m.y,m.r*5);
      gr.addColorStop(0,`rgba(${m.c},${al*.5})`); gr.addColorStop(1,`rgba(${m.c},0)`);
      ctx.fillStyle=gr; ctx.beginPath(); ctx.arc(m.x,m.y,m.r*5,0,Math.PI*2); ctx.fill();
      ctx.fillStyle=`rgba(${m.c},${Math.min(.85,al+.18)})`; ctx.beginPath(); ctx.arc(m.x,m.y,m.r,0,Math.PI*2); ctx.fill();
    });
    if(running) raf=requestAnimationFrame(paint);
  }
  function start(){if(!running){running=true;raf=requestAnimationFrame(paint);}}
  function stop(){running=false;if(raf)cancelAnimationFrame(raf);}
  resize(); start();
  let rt; window.addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(resize,200);});
  document.addEventListener('visibilitychange',()=>document.hidden?stop():start());
})();

initializeApp();
</script>
